{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"site": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string"
				},
				"site": {
					"type": "string",
					"format": "uri"
				},
				"base": {
					"type": "string"
				},
				"trailingSlash": {
					"type": ["boolean", "null"]
				},
				"logos": {
					"type": "object",
					"properties": {
						"favicon": {
							"type": "string"
						},
						"faviconSvg": {
							"type": "string"
						},
						"appleTouchIcon": {
							"type": "string"
						}
					}
				}
			},
			"required": ["name"],
			"additionalProperties": false
		},
		"metadata": {
			"type": "object",
			"properties": {
				"title": {
					"type": "object",
					"properties": {
						"default": {
							"type": ["string", "null"]
						},
						"template": {
							"type": ["string", "null"]
						}
					}
				},
				"author": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"robots": {
					"type": "object",
					"properties": {
						"index": {
							"type": "boolean"
						},
						"follow": {
							"type": "boolean"
						}
					}
				},
				"openGraph": {
					"type": "object",
					"properties": {
						"site_name": {
							"type": "string"
						},
						"images": {
							"type": "array",
							"items": [
								{
									"type": "object",
									"properties": {
										"url": {
											"type": "string"
										},
										"width": {
											"type": "integer"
										},
										"height": {
											"type": "integer"
										}
									},
									"required": ["url", "width", "height"]
								}
							]
						},
						"type": {
							"type": "string"
						}
					},
					"required": []
				},
				"twitter": {
					"type": "object",
					"properties": {
						"handle": {
							"type": "string"
						},
						"site": {
							"type": "string"
						},
						"cardType": {
							"type": "string"
						}
					},
					"required": ["handle", "site", "cardType"]
				},
				"manifestPublic": {
					"type": ["string", "null"]
				}
			},
			"required": ["description"],
			"additionalProperties": false
		},
		"i18n": {
			"type": "object",
			"properties": {
				"language": {
					"type": "string"
				},
				"textDirection": {
					"type": "string"
				}
			},
			"required": ["language", "textDirection"],
			"additionalProperties": false
		},
		"analytics": {
			"type": "object",
			"properties": {
				"vendor": {
					"type": "string",
					"enum": ["fathom", "googleAnalytics", "metrical", "plausible", "simpleAnalytics", "umami", "amplitude", "matomo", "minimalAnalytics", "none"]
				}
			},
			"additionalProperties": false
		},
		"ui": {
			"type": "object",
			"properties": {
				"theme": {
					"type": "string",
					"enum": ["system", "light", "dark", "light:only", "dark:only"]
				},
				"layout": {
					"type": "string",
					"enum": ["narrow", "wide"]
				},
				"light": {
					"type": "object",
					"description": "One colour mode. Every colour here is ramped 50-900; light lands on :root and dark on .dark, so one class retints the site. Both modes should declare the same keys.",
					"properties": {
						"colors": {
							"type": "object",
							"description": "Any key becomes --color-<name> plus a 50-900 ramp and an rgb companion.",
							"additionalProperties": {
								"type": "string",
								"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
							}
						},
						"shadow": {
							"type": "string",
							"description": "Box-shadow for this mode, exposed as --c-shadow."
						}
					},
					"additionalProperties": false
				},
				"dark": {
					"type": "object",
					"description": "One colour mode. Every colour here is ramped 50-900; light lands on :root and dark on .dark, so one class retints the site. Both modes should declare the same keys.",
					"properties": {
						"colors": {
							"type": "object",
							"description": "Any key becomes --color-<name> plus a 50-900 ramp and an rgb companion.",
							"additionalProperties": {
								"type": "string",
								"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
							}
						},
						"shadow": {
							"type": "string",
							"description": "Box-shadow for this mode, exposed as --c-shadow."
						}
					},
					"additionalProperties": false
				},
				"fonts": {
					"type": "object",
					"properties": {
						"family": {
							"type": "object",
							"description": "Any number of families. Each key becomes a --font-<key> variable via astro-font; add a matching <key>_type for the fallback stack.",
							"additionalProperties": {
								"type": "string"
							}
						},
						"font_size": {
							"type": "object",
							"properties": {
								"basePx": {
									"type": "integer"
								},
								"scale": {
									"type": "number",
									"maximum": 1,
									"minimum": 0
								}
							}
						}
					}
				}
			},
			"required": ["theme"],
			"additionalProperties": false
		},
		"about": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string"
				},
				"focuses": {
					"oneOf": [
						{
							"type": "string"
						},
						{
							"type": "array",
							"items": {
								"type": "string"
							}
						}
					]
				},
				"availability": {
					"type": "object",
					"properties": {
						"status": {
							"type": "string",
							"description": "The status of the availability.",
							"enum": ["available", "unavailable", "notice_required"]
						},
						"text": {
							"type": "string",
							"description": "The text to display for the availability status."
						},
						"noticeRequired": {
							"type": "string",
							"description": "The notice required for the availability status.",
							"oneOf": [
								{
									"type": "string"
								},
								{
									"type": "string",
									"enum": ["Minimal", "Standard", "Extended", "None"]
								}
							]
						}
					},
					"required": ["status"]
				},
				"dob": {
					"type": "string"
				},
				"location": {
					"type": "object",
					"properties": {
						"city": {
							"type": "string"
						},
						"countryCode": {
							"type": "string"
						},
						"region": {
							"type": "string"
						}
					},
					"required": ["city", "countryCode", "region"]
				},
				"workRights": {
					"type": "string",
					"description": "Work rights and sponsorship requirements."
				},
				"nationality": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"label": {
								"type": "string"
							},
							"flagIcon": {
								"type": "string"
							}
						},
						"required": ["label"]
					}
				},
				"linguistics": {
					"type": "object",
					"properties": {
						"summary": {
							"type": "string"
						},
						"languages": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"language": {
										"type": "string"
									},
									"fluency": {
										"type": "string",
										"enum": ["Native", "Fluent", "Conversational", "Elementary", "Beginner"]
									},
									"description": {
										"type": "string"
									}
								},
								"required": ["language", "fluency"]
							}
						}
					}
				},
				"profileImages": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						},
						"required": ["name", "url"]
					}
				}
			},
			"required": ["name", "focuses", "dob", "location"]
		},
		"display": {
			"type": "object",
			"properties": {
				"tagline": {
					"type": "string",
					"description": "The tagline to display."
				},
				"showTagline": {
					"type": "boolean",
					"description": "Whether to show the tagline.",
					"default": true
				},
				"showAvailability": {
					"type": "boolean",
					"description": "Whether to show the availability status.",
					"default": true
				},
				"showAvatar": {
					"type": "boolean",
					"description": "Whether to show the avatar in the logo.",
					"default": true
				},
				"footer": {
					"type": "object",
					"properties": {
						"lead": {
							"type": "object",
							"properties": {
								"title": {
									"type": "string"
								},
								"description": {
									"type": "string"
								}
							}
						}
					},
					"required": ["lead"]
				}
			}
		},
		"sidebar": {
			"type": "object",
			"properties": {
				"storageKey": {
					"type": "string",
					"description": "localStorage key holding the visitor's open/closed preference.",
					"default": "sidebarOpen"
				},
				"autoHideAt": {
					"type": "string",
					"description": "Below this breakpoint the sidebar is off-canvas by default and closes on navigation.",
					"enum": ["sm", "md", "lg", "xl", "2xl", "3xl", "4xl"],
					"default": "2xl"
				},
				"toggleAttr": {
					"type": "string",
					"description": "The `data-*` attribute every toggle carries.",
					"default": "data-menu-toggle"
				},
				"onLoad": {
					"type": "string",
					"description": "What a first-time visitor gets, before any preference exists.",
					"default": "open",
					"enum": ["open", "closed", "reveal"]
				}
			}
		},
		"socials": {
			"type": "object",
			"properties": {
				"email": {
					"$ref": "#/definitions/socialLink"
				},
				"phone": {
					"$ref": "#/definitions/socialLink"
				},
				"github": {
					"$ref": "#/definitions/socialLink"
				},
				"linkedin": {
					"$ref": "#/definitions/socialLink"
				},
				"facebook": {
					"$ref": "#/definitions/socialLink"
				},
				"x": {
					"$ref": "#/definitions/socialLink"
				},
				"youtube": {
					"$ref": "#/definitions/socialLink"
				},
				"codepen": {
					"$ref": "#/definitions/socialLink"
				},
				"whatsapp": {
					"$ref": "#/definitions/socialLink"
				},
				"vcard": {
					"$ref": "#/definitions/socialLink"
				}
			},
			"required": []
		}
	},
	"required": ["site"],
	"definitions": {
		"socialLink": {
			"type": "object",
			"properties": {
				"text": {
					"type": "string"
				},
				"href": {
					"type": "string"
				},
				"suffixIcon": {
					"type": "string"
				}
			},
			"required": ["text", "href"],
			"additionalProperties": false
		}
	}
}
