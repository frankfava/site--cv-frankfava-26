{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"site": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string"
				},
				"site": {
					"type": "string",
					"format": "uri"
				},
				"base": {
					"type": "string"
				},
				"trailingSlash": {
					"type": ["boolean", "null"]
				},
				"logos": {
					"type": "object",
					"properties": {
						"favicon": {
							"type": "string"
						},
						"faviconSvg": {
							"type": "string"
						},
						"appleTouchIcon": {
							"type": "string"
						}
					}
				}
			},
			"required": ["name"],
			"additionalProperties": false
		},
		"metadata": {
			"type": "object",
			"properties": {
				"title": {
					"type": "object",
					"properties": {
						"default": {
							"type": ["string", "null"]
						},
						"template": {
							"type": ["string", "null"]
						}
					}
				},
				"author": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"robots": {
					"type": "object",
					"properties": {
						"index": {
							"type": "boolean"
						},
						"follow": {
							"type": "boolean"
						}
					}
				},
				"openGraph": {
					"type": "object",
					"properties": {
						"site_name": {
							"type": "string"
						},
						"images": {
							"type": "array",
							"items": [
								{
									"type": "object",
									"properties": {
										"url": {
											"type": "string"
										},
										"width": {
											"type": "integer"
										},
										"height": {
											"type": "integer"
										}
									},
									"required": ["url", "width", "height"]
								}
							]
						},
						"type": {
							"type": "string"
						}
					},
					"required": []
				},
				"twitter": {
					"type": "object",
					"properties": {
						"handle": {
							"type": "string"
						},
						"site": {
							"type": "string"
						},
						"cardType": {
							"type": "string"
						}
					},
					"required": ["handle", "site", "cardType"]
				},
				"manifestPublic": {
					"type": ["string", "null"]
				}
			},
			"required": ["description"],
			"additionalProperties": false
		},
		"i18n": {
			"type": "object",
			"properties": {
				"language": {
					"type": "string"
				},
				"textDirection": {
					"type": "string"
				}
			},
			"required": ["language", "textDirection"],
			"additionalProperties": false
		},
		"ui": {
			"type": "object",
			"properties": {
				"theme": {
					"type": "string",
					"enum": ["system", "light", "dark", "light:only", "dark:only"]
				},
				"colors": {
					"type": "object",
					"properties": {
						"primary": {
							"type": "string"
						},
						"secondary": {
							"type": "string"
						},
						"accent": {
							"type": "string"
						}
					}
				},
				"fonts": {
					"type": "object",
					"properties": {
						"family": {
							"type": "object",
							"properties": {
								"primary": {
									"type": "string"
								},
								"primary_type": {
									"type": "string",
									"enum": ["sans-serif", "serif", "monospace"]
								},
								"secondary": {
									"type": "string"
								},
								"secondary_type": {
									"type": "string",
									"enum": ["sans-serif", "serif", "monospace"]
								}
							}
						},
						"font_size": {
							"type": "object",
							"properties": {
								"basePx": {
									"type": "integer"
								},
								"scale": {
									"type": "number",
									"maximum": 1,
									"minimum": 0
								}
							}
						}
					}
				}
			},
			"required": ["theme"],
			"additionalProperties": false
		}
	},
	"required": ["site"]
}
