#!/bin/sh
# Conventional Commits gate. Pure shell, no dependencies, so it costs a few ms.
# Spec: https://www.conventionalcommits.org/en/v1.0.0/

subject=$(sed -n '1{/^#/d;p;}' "$1")

# Merges, fixups and reverts are generated by git; they are not ours to format.
case "$subject" in
	'') exit 0 ;;
	Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'

if printf '%s' "$subject" | grep -qE "^($types)(\([a-z0-9./-]+\))?!?: .+"; then
	exit 0
fi

printf '\n  Commit message does not follow Conventional Commits.\n\n'
printf '  got:      %s\n' "$subject"
printf '  expected: <type>[optional scope][!]: <description>\n\n'
printf '  types:    %s\n\n' "$(printf '%s' "$types" | tr '|' ' ')"
printf '  examples: feat: add capability radar\n'
printf '            fix(bay): stop the footer cutting the index short\n'
printf '            build: install alpinejs\n'
printf '            feat!: drop the /v2 route\n\n'
exit 1
