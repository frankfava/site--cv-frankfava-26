---
/**
 * Experience page.
 */

import { blueprints } from "@/data/blueprints";
import SubIndexedLayout from "@/layouts/SubIndexedLayout.astro";
import { careerStart, roleCount } from "@/lib/spans";
import { inWords } from "@/utils/number";

const entry = blueprints.experience;

const metadata = {
	title: entry.title,
	description: entry.description,
};
---

<SubIndexedLayout {...{ metadata, blueprint: entry }}>
	<Fragment slot="lead">{inWords(roleCount(), "Sentence")} roles since {careerStart().getFullYear()}, across two continents, in full and most recent first.</Fragment>
</SubIndexedLayout>
