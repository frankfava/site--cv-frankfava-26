---
/**
 * Experience page.
 */

import { blueprints } from "@/data/blueprints";
import SubIndexedLayout from "@/layouts/SubIndexedLayout.astro";

const entry = blueprints.experience;

const metadata = {
	title: entry.title,
	description: entry.description,
};
---

<SubIndexedLayout {...{ metadata, blueprint: entry }}>
	<Fragment slot="lead">Nine roles since 2008, across two continents, in full and most recent first.</Fragment>
</SubIndexedLayout>
