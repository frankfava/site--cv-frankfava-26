---
import SubIndexedLayout from "@/layouts/SubIndexedLayout.astro";
import { onlyEnabledRoles, ROLES } from "@/data/roles";
import { findBrokenFeaturedIds, getRole } from "@/data/roleDefinitions";
import { buildRolePageContext } from "@/utils/rolePageContext";

export async function getStaticPaths() {
	const broken = await findBrokenFeaturedIds();
	if (broken.length) throw new Error(`[roles] featured ids do not resolve:\n  ${broken.join("\n  ")}`);

	return onlyEnabledRoles(ROLES).map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
// getStaticPaths only emits slugs the registry has, so the lookup cannot miss.
const role = getRole(slug!)!;

const { roleAnchorIds, metadata } = buildRolePageContext({ entry: role });
Astro.locals.roleAnchorIds = roleAnchorIds;
---

<SubIndexedLayout
	{...{
		metadata,
		blueprint: role,
		head: {
			eyebrow: "Role dossier",
			backLink: { href: "/", text: "&larr; Back to the front page" },
			actions: [{ text: "One-Pager", href: `/roles/${slug}/one-pager`, icon: "ph:file-pdf-duotone" }],
		},
	}}
/>
