---
import BlueprintLayout from "@/layouts/BlueprintLayout.astro";
import { onlyEnabledRoles, ROLES } from "@/data/roleDefinitions";
import type { BlueprintEntry } from "@/lib/blueprints";
import { buildRolePageContext } from "@/utils/rolePageContext";

export async function getStaticPaths() {
	return onlyEnabledRoles(ROLES).map((role) => ({
		params: { slug: role.slug },
		props: { entry: role as BlueprintEntry },
	}));
}

interface Props {
	entry: BlueprintEntry;
}

const { entry } = Astro.props;
const { roleAnchorIds, metadata } = buildRolePageContext({ entry });
Astro.locals.roleAnchorIds = roleAnchorIds;
---

<BlueprintLayout metadata={metadata} blueprint={entry} />
