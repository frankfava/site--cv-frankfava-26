---
import PageLayout from "@/layouts/PageLayout.astro";

import CONFIG from "site:config";

const metadata = {};
---

<PageLayout metadata={metadata}>
	<div class="flex flex-col h-screen">
		<div class="flex grow overflow-y-auto">
			<aside class="h-full w-50 sticky top-0 bg-primary-50 border-r">
				<div class="space-y-10 overflow-y-auto h-full p-4"></div>
			</aside>
			<main class"grow pb-10">
				<pre class="whitespace-pre-wrap text-sm p-5">{ JSON.stringify(CONFIG,null,4)}</pre>
			</main>
		</div>
	</div>
</PageLayout>
