---
import IndexedLayout from "@/layouts/IndexedLayout.astro";
import Hero from "@/components/shared/Hero.astro";
import { blueprints } from "@/data/blueprints";
import { METADATA, ABOUT } from "site:config";
import ParticleField from "@/components/shared/backgrounds/ParticleField.astro";
import Orb from "@/components/shared/backgrounds/Orb.astro";
import { codingYears, customerFacingYears, startYearOf, yearsIn } from "@/lib/spans";
import { inWords } from "@/utils/number";

const metadata = {
	title: METADATA?.title?.default,
	ignoreTitleTemplate: true,
};
---

<IndexedLayout {...{ metadata, blueprint: blueprints.home, fullHeight: false }}>
	<Hero
		slot="hero"
		class="dark"
		facts={[
			{ value: `${customerFacingYears()} yrs`, label: "with a customer in front of me" },
			{ value: "160+", label: "projects sold and delivered" },
			{ value: "EU / EEA", label: "work rights" },
		]}
	>
		<Fragment slot="backgroundAnimation">
			<ParticleField />
			<Orb />
		</Fragment>
		<Fragment slot="eyebrow">
			<div class="flex flex-col gap-1 lg:flex-row">
				<span>{ABOUT.location?.city}</span>
				<span class="mx-1 hidden lg:inline">|</span>
				<span>{ABOUT.focuses.slice(0, 4).join(" · ")}</span>
			</div>
		</Fragment>
		<Fragment slot="heading">
			I'm the person between the problem and <b>the system that fixes it.</b>
		</Fragment>
		<Fragment slot="lead">
			{inWords(codingYears(), "Sentence")} years winning the work, designing it and building it. {inWords(customerFacingYears(), "Sentence")} years with a customer in front of me, and leading the
			people who build the rest since {startYearOf("igomoon")}. {inWords(yearsIn("nas"), "Sentence")} years as one company's only technical voice, and <b>still the call when it breaks</b>. These
			days the systems are agentic, and I run mine in production every day.
		</Fragment>
	</Hero>
</IndexedLayout>
