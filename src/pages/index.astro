---
import IndexedLayout from "@/layouts/IndexedLayout.astro";
import Hero from "@/components/shared/Hero.astro";
import { blueprints } from "@/data/blueprints";
import { METADATA, ABOUT } from "site:config";
import ParticleField from "@/components/shared/backgrounds/ParticleField.astro";
import Orb from "@/components/shared/backgrounds/Orb.astro";
import { careerYears, yearsIn } from "@/lib/spans";
import { inWords } from "@/utils/number";

const metadata = {
	title: METADATA?.title?.default,
	ignoreTitleTemplate: true,
};
---

<IndexedLayout {...{ metadata, blueprint: blueprints.home, fullHeight: false }}>
	<Hero
		slot="hero"
		class="dark"
		facts={[
			{ value: "10 yrs", label: "customer-facing technical" },
			{ value: "160+", label: "projects sold and delivered" },
			{ value: "EU / EEA", label: "work rights" },
		]}
	>
		<Fragment slot="backgroundAnimation">
			<ParticleField />
			<Orb />
		</Fragment>
		<Fragment slot="eyebrow">
			<div class="flex flex-col gap-1 lg:flex-row">
				<span>{ABOUT.location?.city}</span>
				<span class="mx-1 hidden lg:inline">|</span>
				<span>{ABOUT.focuses.slice(0, 4).join(" · ")}</span>
			</div>
		</Fragment>
		<Fragment slot="heading">
			I'm the person between your customer's problem and <b>the system that fixes it.</b>
		</Fragment>
		<Fragment slot="lead">
			{inWords(careerYears(), "Sentence")} years of winning the work, designing it, building it, leading the people who build the rest of it, and <b
				>still being the call when it breaks {inWords(yearsIn("nas"))} years later</b
			>. Ten of those years customer-facing. These days the systems are agentic, and I run mine in production every day.
		</Fragment>
	</Hero>
</IndexedLayout>
