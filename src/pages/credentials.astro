---
/**
 * Credentials page.
 */

import { blueprints } from "@/data/blueprints";
import SubIndexedLayout from "@/layouts/SubIndexedLayout.astro";

const entry = blueprints.credentials;

const metadata = {
	title: entry.title,
	description: entry.description,
};
---

<SubIndexedLayout {...{ metadata, blueprint: entry }}>
	<Fragment slot="lead">What I hold, what I do not, and where every one of them can be checked.</Fragment>
</SubIndexedLayout>
