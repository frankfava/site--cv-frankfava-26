---
/**
 * About me page.
 */

import { blueprints } from "@/data/blueprints";
import SubIndexedLayout from "@/layouts/SubIndexedLayout.astro";

const entry = blueprints.about;

const metadata = {
	title: entry.title,
	description: entry.description,
};
---

<SubIndexedLayout {...{ metadata, blueprint: entry }}>
	<Fragment slot="lead">Who I am, how I behave when the work goes badly, and what happens when someone else does the scoring.</Fragment>
</SubIndexedLayout>
