---
import SwitchCase from "@/components/ui/display/SwitchCase.astro";
import LanguageList from "@/components/blueprints/shared/_partials/LanguageList.astro";
import { ABOUT } from "site:config";
import type { TransferableSkillMeta } from "@/utils/transferableSkills";

export const meta: TransferableSkillMeta = {
	title: "Languages",
	summary: ABOUT.linguistics.languages.map((l) => `${l.language}${l.fluency ? ` (${l.fluency})` : ""}`).join(" · "),
	icon: "ph:translate-duotone",
	featured: true,
	order: 70,
	keywords: ["languages", "communication"],
};

interface Props {
	only?: string;
}
const { only } = Astro.props;
---

<SwitchCase value={only}>
	<LanguageList slot="default" linguistics={ABOUT.linguistics} />
</SwitchCase>
