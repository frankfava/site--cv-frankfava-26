---
/**
 * The one-page version.
 */
import type { BlueprintPartEntry } from "@/lib/blueprints";
import { SOCIALS } from "site:config";
import { getCanonical } from "@/utils/permalinks";
import PartsDisplay from "../blueprints/part/PartsDisplay.astro";
import Logo from "../Logo.astro";

interface Props {
	eyebrow: string;
	subtitle?: string;
	lead: string;
	footnote?: string;
	showHomeInFooter?: boolean;
	onlinePath?: string;
	sheet?: BlueprintPartEntry;
}

const { eyebrow, subtitle, lead, footnote, showHomeInFooter, onlinePath = "", sheet } = Astro.props;

const homeLink = String(getCanonical("/", { removeProtocol: true }));
const pathLink = getCanonical(onlinePath);

const contact = SOCIALS.displayable();
---

<div
	class="one-pager grid min-h-screen items-start justify-items-center bg-surface font-secondary text-[0.95rem]/[1.55] text-ink print:block print:min-h-0 print:p-0 print:[-webkit-print-color-adjust:exact] print:[print-color-adjust:exact] paper:bg-sunk paper:p-8 sheet:text-[0.85rem]/[1.5]"
>
	<article
		class="flex w-full max-w-full flex-col gap-4 bg-surface p-5 print:h-full print:w-auto print:gap-[3.4mm] print:overflow-visible print:p-0 paper:h-(--sheet-h) paper:w-(--sheet-w) paper:overflow-scroll paper:border paper:border-line paper:p-[10mm_12mm] paper:shadow-lg"
	>
		<header class="flex flex-col justify-center gap-1 border-b border-line pb-3">
			<Logo class="mb-3 max-h-[15mm] w-full" titleClass="text-2xl">
				<p class="font-mono text-xs text-ink-2 uppercase">{subtitle}</p>
			</Logo>

			<p class="font-mono text-xs text-ink-2 uppercase">{eyebrow}</p>

			{
				!!contact.length && (
					<ul class="grid text-ink-2 sheet:flex sheet:flex-wrap">
						{contact.map((entry) => (
							<li class="sheet:not-first:before:px-[1.5mm] sheet:not-first:before:text-ink-3 sheet:not-first:before:content-['·']">
								<a href={entry.href}>{entry.text}</a>
							</li>
						))}
					</ul>
				)
			}

			{
				homeLink !== pathLink && (
					<div class="mt-1">
						<a href={getCanonical(onlinePath)} class="text-[1.05rem] text-accent sheet:text-[0.9rem]">
							{getCanonical(onlinePath)}
						</a>
					</div>
				)
			}
		</header>

		<p class="text-ink" set:html={lead} />

		<slot>
			{
				sheet && (
					<PartsDisplay
						{...{
							sheet: sheet.blueprint.assemble(),
							sectionClass: "print:break-inside-avoid",
							class: "space-y-6",
						}}
					/>
				)
			}
		</slot>

		{
			(footnote || showHomeInFooter) && (
				<footer class="mt-auto flex flex-wrap items-end gap-[5mm] border-t border-line pt-2.5 text-[0.94rem] print:break-inside-avoid sheet:text-[0.8rem]">
					{footnote && <span class="font-normal text-ink">{footnote}</span>}
					{showHomeInFooter && <span class="ml-auto font-mono text-ink-2">{homeLink}</span>}
				</footer>
			)
		}
	</article>
</div>
