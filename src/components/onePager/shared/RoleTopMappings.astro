---
import { type Role } from "@/lib/roles";
import { Icon } from "astro-icon/components";
import OnePagerModule, { type Props as OnePagerProps } from "../OnePagerModule.astro";

interface Props extends OnePagerProps {
	limit?: number;
}

const { limit = 2, ...props } = Astro.props;

const role = Astro.locals.blueprint as Role;

const mappings = role?.mappings ?? [];
const topMappings = limit ? mappings.slice(0, limit) : mappings;
---

<OnePagerModule {...props}>
	{
		!!topMappings.length && (
			<ul class="grid gap-[2mm]">
				{topMappings.map(({ from, to, note }) => (
					<li class="grid gap-[0.4mm] text-[0.8rem]">
						<div class="flex flex-wrap items-center gap-x-[1.5mm]">
							<span class="text-ink-2">{from.label}</span>
							<b class="flex items-center gap-[1.5mm] text-ink">
								<Icon name="ph:arrow-right-duotone" class="size-3 shrink-0 text-ink-3" />
								{to}
							</b>
						</div>
						{note && <p class="m-0 text-[0.7rem]/[1.3] text-ink-3">{note}</p>}
					</li>
				))}
			</ul>
		)
	}
</OnePagerModule>
