---
import { type Role } from "@/lib/roles";
import { getCollection } from "astro:content";
import OnePagerModule, { type Props as OnePagerProps } from "../OnePagerModule.astro";

interface Props extends OnePagerProps {
	limit?: number;
}

const { limit = 1, ...props } = Astro.props;

const role = Astro.locals.blueprint as Role;

const featuredProjects = role?.featuredProjects ?? [];
const allProjects = await getCollection("projects");
const projects = featuredProjects.map((id) => allProjects.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => !!p);
const topProjects = limit ? projects.slice(0, limit) : projects;
---

<OnePagerModule {...props}>
	{
		!!topProjects.length && (
			<ul class="grid gap-[1.6mm]">
				{topProjects.map(({ data }) => (
					<li class="grid gap-[0.4mm]">
						<b class="text-[0.94rem] text-ink sheet:text-[0.8rem]">
							{data.title}
							{data.role && <span class="font-mono text-[0.82rem] font-medium text-accent sheet:text-[0.7rem]"> {data.role}</span>}
						</b>
						{data.summary && <span class="text-[0.84rem]/[1.4] text-ink-3 sheet:text-[0.7rem]/[1.3]">{data.summary}</span>}
					</li>
				))}
			</ul>
		)
	}
</OnePagerModule>
