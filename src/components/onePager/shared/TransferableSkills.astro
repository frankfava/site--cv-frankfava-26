---
import { getTransferableSkills, getTransferableSkillsByIds } from "@/lib/collections/transferableSkills";
import { type Role } from "@/lib/roles";
import OnePagerModule, { type Props as OnePagerProps } from "../OnePagerModule.astro";

interface Props extends OnePagerProps {
	limit?: number;
}

const { limit, ...props } = Astro.props;

const role = Astro.locals.blueprint as Role;

// A role names the ones that argue for it. Either way the run carries titles
// and nothing else, so an entry the collection keeps out of a list has nothing
// left to say here - its meaning lives in the summary a list drops.
const featured = role?.featuredTransferableSkills?.length ? await getTransferableSkillsByIds(role.featuredTransferableSkills) : await getTransferableSkills();
const entries = featured.filter(({ data }) => data.listed);

// Titles read as card headings on the page; the sheet wants the field of knowledge.
const skills = entries.map(({ data }) => data.subject ?? data.title);

const transferable = limit ? skills.slice(0, limit) : skills;
---

<OnePagerModule {...props}>
	{!!transferable.length && <p class="text-[0.92rem]/[1.5] text-ink-2 sheet:text-[0.78rem]/[1.42]">{transferable.join(" · ")}</p>}
</OnePagerModule>
