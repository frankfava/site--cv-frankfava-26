---
import { SCENARIOS } from "@/data/scenarios";
import OnePagerModule, { type Props as OnePagerProps } from "../OnePagerModule.astro";

interface Props extends OnePagerProps {
	limit?: number;
}

const { limit = 4, ...props } = Astro.props;

const scenarios = SCENARIOS.map((scenario) => ({ claim: scenario.title, figure: scenario.proof[0], where: scenario.eyebrow }));
const proofs = limit ? scenarios.slice(0, limit) : scenarios;
---

<OnePagerModule {...props}>
	{
		!!proofs.length && (
			<ul class="grid grid-cols-1 gap-x-[6mm] gap-y-[1.8mm] sheet:grid-cols-2">
				{proofs.map((entry) => (
					<li class="grid gap-[0.6mm] border-l-2 border-accent pl-[3mm]">
						<b class="text-[0.98rem] text-ink sheet:text-[0.84rem]">{entry.claim}</b>
						<span class="font-mono text-[0.88rem]/[1.45] text-accent sheet:text-xs/[1.38]">
							{entry.figure.figure} <span class="text-ink-3">{entry.figure.note}</span>
						</span>
						<span class="text-[0.84rem]/[1.4] text-ink-3 sheet:text-[0.7rem]/[1.3]">{entry.where}</span>
					</li>
				))}
			</ul>
		)
	}
</OnePagerModule>
