---
import ModuleWrapper, { type _ModuleHeader, type _ModuleWrapper } from "@/components/ui/modules/ModuleWrapper.astro";
import { Icon } from "astro-icon/components";
import { getCollection, type CollectionEntry } from "astro:content";
import type { Role } from "@/lib/roles";

// Read by BlueprintSectionBuild - empty result hides the whole section.
export async function resolve(role: Role | undefined): Promise<CollectionEntry<"projects">[]> {
	const featured = role?.featuredCaseStudies ?? [];
	if (featured.length === 0) return [];
	const all = await getCollection("projects");
	return featured.map((id) => all.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => !!p && !!p.data.caseStudy);
}

export interface Props extends _ModuleWrapper {}

const props = Astro.props;
const role = Astro.locals.blueprint as Role;

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "Case Studies",
};

const studies = await resolve(role);
---

<ModuleWrapper {...{ ...props, header }}>
	<p>End-to-end ownership: read the actual problem, agree the solution, build it, ship the outcome.</p>

	<div class="my-8 grid gap-6">
		{
			studies.map((p) => {
				const cs = p.data.caseStudy!;
				return (
					<div class="overflow-hidden rounded border border-line bg-surface">
						<div class="flex items-center gap-3 border-b border-line bg-surface p-4">
							{p.data.icon && <Icon name={p.data.icon} class="size-8 min-h-8 min-w-8 text-accent" />}
							<div>
								<h3 class="m-0 text-xl font-bold">{p.data.title}</h3>
								{p.data.role && <div class="text-sm text-ink-3">{p.data.role}</div>}
							</div>
						</div>
						<dl class="grid gap-x-4 gap-y-3 p-4 text-sm sm:grid-cols-[110px_1fr]">
							<dt class="font-semibold tracking-wide text-ink-2 uppercase">Problem</dt>
							<dd class="m-0">{cs.problem}</dd>
							<dt class="font-semibold tracking-wide text-ink-2 uppercase">Solution</dt>
							<dd class="m-0">{cs.solution}</dd>
							<dt class="font-semibold tracking-wide text-ink-2 uppercase">Build</dt>
							<dd class="m-0" set:html={cs.build} />
							<dt class="font-semibold tracking-wide text-ink-2 uppercase">Outcome</dt>
							<dd class="m-0 font-semibold text-ink">{cs.outcome}</dd>
						</dl>
					</div>
				);
			})
		}
	</div>
</ModuleWrapper>
