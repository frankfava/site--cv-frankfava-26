---
import { Icon } from "astro-icon/components";
import ModuleWrapper, { type _ModuleHeader, type _ModuleWrapper } from "@/components/ui/modules/ModuleWrapper.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import type { Role } from "@/lib/roles";

export interface Props extends _ModuleWrapper {}

// Read by BlueprintSectionBuild - empty result hides the whole section.
export async function resolve(role: Role | undefined): Promise<CollectionEntry<"projects">[]> {
	const featured = role?.featuredProjects ?? [];
	if (featured.length === 0) return [];
	const all = await getCollection("projects");
	return featured.map((id) => all.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => !!p);
}

const props = Astro.props;
const role = Astro.locals.blueprint as Role;

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "Featured Projects",
};

const projects = await resolve(role);
---

<ModuleWrapper {...{ ...props, header }}>
	<div slot="afterHeader" class="mt-3">
		<a
			href="/work#projects"
			class="inline-flex items-center gap-2 rounded-md bg-accent px-2 py-1.5 text-xs font-semibold whitespace-nowrap text-white! hover:bg-accent-800 focus:ring-4 focus:ring-accent focus:outline-none dark:text-ground! dark:hover:bg-accent-300 print:hidden"
			data-no-print
		>
			<Icon name="ph:desktop" class="size-4" />
			View All
		</a>
	</div>
	<div class="grid gap-3 md:grid-cols-2">
		{
			projects.map(({ data }) => (
				<div class="grid gap-3 rounded-md border border-line bg-surface p-4 shadow-md">
					<div>
						<h4 class="m-0 text-lg font-semibold text-accent">{data.title}</h4>
						{data.summary && <p class="m-0 text-ink-3">{data.summary}</p>}
					</div>
					{(data.demoUrl || data.repoUrl) && (
						<div class="flex flex-wrap gap-3">
							{data.demoUrl && (
								<a href={data.demoUrl} target="_blank" rel="noopener">
									Demo
								</a>
							)}
							{data.repoUrl && (
								<a href={data.repoUrl} target="_blank" rel="noopener">
									Source
								</a>
							)}
						</div>
					)}
				</div>
			))
		}
	</div>
</ModuleWrapper>
