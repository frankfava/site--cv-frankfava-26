---
import { THEME } from "site:config";

/** A locked theme needs no switcher, and the pre-paint script is the only thing here. */
if (THEME.default?.endsWith(":only")) {
	return;
}
---

<script is:inline define:vars={{ defaultTheme: THEME.default || "system" }}>
	window.colorSchemeSwitcher = new (class {
		constructor() {
			this.localStorageKey = "darkColorScheme";
			this.setListeners();
		}
		getFromMedia() {
			return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
		}
		savedInStorage() {
			return this.localStorageKey in localStorage;
		}
		darkModeEnabled() {
			return localStorage.getItem(this.localStorageKey) == "true";
		}
		getPreference() {
			return !this.savedInStorage() ? "system" : this.darkModeEnabled() ? "dark" : "light";
		}
		savePreference(theme) {
			if ((!theme && theme !== undefined) || theme == "system") {
				localStorage.removeItem(this.localStorageKey);
			} else if (!!theme) {
				localStorage.setItem(this.localStorageKey, theme == "dark");
			}
		}
		lightOrDark() {
			return !this.savedInStorage() ? this.getFromMedia() : this.getPreference();
		}
		setTheme(theme) {
			this.savePreference(theme);
			this.updateAttribute(this.lightOrDark());
		}
		updateAttribute(preference) {
			if (preference == "dark") {
				document.documentElement.classList.add("dark");
			} else {
				document.documentElement.classList.remove("dark");
			}
		}
		setListeners() {
			window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
				this.setTheme();
			});
		}
		init() {
			if (this.savedInStorage()) {
				this.setTheme(this.getPreference());
				return;
			}

			if (defaultTheme && defaultTheme.endsWith(":only")) {
				this.setTheme(defaultTheme.replace(":only", ""));
			} else {
				this.setTheme(defaultTheme);
			}
		}
	})();
	colorSchemeSwitcher.init();
</script>
