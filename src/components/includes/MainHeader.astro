---
import { SOCIALS } from "site:config";

import Logo from "@/components/Logo.astro";
import SocialLinks from "@/components/ui/social/SocialLinks.astro";
import ToggleMenu from "@/components/ui/menu/ToggleMenu.astro";
import ToggleTheme from "@/components/ui/input/ToggleTheme.astro";
import ButtonGroup from "@/components/ui/input/ButtonGroup.astro";
import MenuItems from "@/components/ui/menu/MenuItems.astro";
import ScrollProgressBar from "@/components/ui/scroll/ScrollProgressBar.astro";
import { Icon } from "astro-icon/components";

import type { Link, _CallToAction } from "@/types";
import { getCurrentPath, getHomePermalink } from "@/utils/permalinks";

export interface Props {
	id?: string;
	logo?: string;
	// Style
	isSticky?: boolean;
	isDark?: boolean;
	addShadow?: boolean;
	isFullWidth?: boolean;
	// Behavior
	showScrollProgress?: boolean;
	animateScrollProgress?: boolean;
	shrinkHeader?: boolean;
	showSidebar?: boolean;
	sidebarToggle?: string;
	// Links/Menu
	links?: Array<Link>;
	showLinkIcons?: boolean;
	menuPosition?: "left" | "right" | "center";
	beforeMenu?: string;
	afterMenu?: string;
	// Actions
	actions?: Array<_CallToAction>;
	beforeActions?: string;
	afterActions?: string;
	showSocialLinks?: boolean;
	showToggleTheme?: boolean;
}

const {
	id = "header",
	logo = await Astro.slots.render("logo"),
	// Style
	isSticky = true,
	isDark = true,
	addShadow = true,
	isFullWidth = true,
	// Behavior
	showScrollProgress = true,
	animateScrollProgress = true,
	shrinkHeader = false,
	showSidebar = true,
	sidebarToggle = await Astro.slots.render("sidebarToggle"),
	// Links
	links = [],
	showLinkIcons,
	menuPosition = "center",
	beforeMenu = await Astro.slots.render("beforeMenu"),
	afterMenu = await Astro.slots.render("afterMenu"),
	// Actions
	actions = [],
	beforeActions = await Astro.slots.render("beforeActions"),
	afterActions = await Astro.slots.render("afterActions"),
	showSocialLinks = true,
	showToggleTheme = false,
} = Astro.props;

const hasBeforeMenuSlot = Astro.slots.has("beforeMenu") && typeof beforeMenu == "string" && !!beforeMenu;
const hasAfterMenuSlot = Astro.slots.has("afterMenu") && typeof afterMenu == "string" && !!afterMenu;

const currentPath = getCurrentPath(Astro.url);
---

<header
	class:list={[
		{
			fixed: isSticky,
			relative: !isSticky,
			dark: isDark,
			"shadow-[0_5px_10px_0_rgba(0,0,0,0.3)]": addShadow,
		},
		"top-0 z-70! flex w-full flex-col bg-header font-secondary text-page print:hidden",
	]}
	{...isSticky ? { "data-sticky-header": true } : {}}
	{...shrinkHeader ? { "data-shrink-header": true } : {}}
	{...showScrollProgress
		? {
				"data-scroll-progress": animateScrollProgress ? "animate" : "show",
			}
		: {}}
	{...id ? { id } : {}}
	data-main-header
>
	<div
		id="header-inner"
		class:list={[
			"text-default relative mx-auto flex w-full flex-wrap items-center gap-2 px-5 py-3 sm:flex-nowrap sm:gap-4 sm:px-6 sm:py-0 lg:grow",
			{
				"items-center md:flex md:justify-between": menuPosition !== "center",
				"flex w-full items-center": menuPosition === "center",
				"max-w-screen-2xl": !isFullWidth,
			},
		]}
	>
		<div class:list={[{ "mr-auto rtl:mr-0 rtl:ml-auto": menuPosition === "right" && !hasBeforeMenuSlot }, "flex items-center gap-2 md:gap-5"]}>
			{showSidebar && <ToggleMenu class="mobile-toggle lg:hidden" />}
			{
				showSidebar &&
					(Astro.slots.has("sidebarToggle") && typeof sidebarToggle == "string" && !!sidebarToggle ? (
						<span class="sidebar-toggle hidden lg:block">
							<Fragment set:html={sidebarToggle} />
						</span>
					) : (
						<ToggleMenu class="sidebar-toggle hidden lg:flex">
							<Icon name="ph:sidebar-duotone" class="size-8" />
						</ToggleMenu>
					))
			}
			<a class="logo-link flex items-center" href={currentPath == "/" ? "#top" : getHomePermalink()}>
				{Astro.slots.has("logo") && typeof logo == "string" && !!logo ? <Fragment set:html={logo} /> : <Logo showImage={true} class="site-logo" />}
			</a>
		</div>
		{
			hasBeforeMenuSlot ? (
				<div class:list={{ "mr-auto": menuPosition === "right" }}>
					<Fragment set:html={beforeMenu} />
				</div>
			) : (
				""
			)
		}
		<div
			class="flex"
			class:list={{
				"mx-auto": menuPosition === "center",
				"mr-auto": menuPosition === "left",
				"ml-auto": menuPosition === "right",
			}}
		>
			{
				!!links.length && (
					<nav id="header-nav" class="text-default flex w-auto items-center justify-self-center md:overflow-x-auto xl:overflow-x-hidden" aria-label="Main navigation">
						<ul class="flex w-full flex-row justify-center gap-2 self-center py-0 text-[0.8rem] font-semibold">
							<MenuItems
								links={links}
								showLinkIcons={showLinkIcons}
								linkClass={(link) => [
									"text-base no-underline",
									{
										"link-active bg-gray-50 text-gray-800 dark:text-gray-50 dark:bg-gray-800": link.href === currentPath,
									},
								]}
							/>
						</ul>
					</nav>
				)
			}
		</div>
		{
			hasAfterMenuSlot ? (
				<div class:list={{ "ml-auto": menuPosition === "left" }}>
					<Fragment set:html={afterMenu} />
				</div>
			) : (
				""
			)
		}
		{showScrollProgress && <ScrollProgressBar />}
		<div
			class:list={[
				{ "ml-auto rtl:mr-auto rtl:ml-0": menuPosition === "left" && !hasAfterMenuSlot },
				"fixed bottom-0 left-0 hidden w-full items-center justify-end p-3 md:static md:mb-0 md:flex md:w-auto md:self-center md:justify-self-end md:p-0 rtl:right-0 rtl:left-auto",
			]}
		>
			<div class="ml-0 flex w-full items-center justify-between gap-3 sm:w-auto sm:justify-normal lg:gap-2">
				{Astro.slots.has("beforeActions") && typeof beforeActions == "string" && !!beforeActions ? <Fragment set:html={beforeActions} /> : ""}
				<ButtonGroup actions={actions.slice(0, 2)} btnClass="py-2.5 px-5.5 md:px-6" />
				{showSocialLinks && <SocialLinks socialLinks={SOCIALS.toArray()} showText={false} class="gap-1 lg:gap-2" linkClass="rounded-md p-2" iconClass="w-6 h-6" />}
				{showToggleTheme && <ToggleTheme variant="single" class="rounded-md border-line p-2 text-ink-2 hover:border-accent hover:text-accent" iconClass="w-6 h-6" />}
				{Astro.slots.has("afterActions") && typeof afterActions == "string" && !!afterActions ? <Fragment set:html={afterActions} /> : ""}
			</div>
		</div>
	</div>
</header>
