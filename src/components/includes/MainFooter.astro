---
import { SOCIALS, THEME, DISPLAY } from "site:config";

import Logo from "@/components/Logo.astro";
import SocialLinks from "@/components/ui/menu/SocialLinks.astro";
import ButtonGroup from "@/components/ui/input/ButtonGroup.astro";

import type { _CallToAction, Socials, Link, App } from "@/types";

import { getCurrentPath, getHomePermalink } from "@/utils/permalinks";

export interface Props {
	id?: string;
	lead?: string | { title: string; description?: string };
	links?: Array<Link>;
	actions?: Array<_CallToAction>;
	isDark?: boolean;
	socialLinks?: boolean | Socials.Link[];
	showSocialText?: boolean;
	layout?: App.UIConfig["layout"];
}

const { id = "footer", lead = await Astro.slots.render("lead"), links = [], actions = [], isDark = false, socialLinks = true, showSocialText = false, layout: layoutProp = "narrow" } = Astro.props;

const layout = (layoutProp || THEME.layout) as App.UIConfig["layout"];

const leadTitle = typeof lead == "object" && lead?.title ? lead.title : DISPLAY.footer.lead?.title;
const leadDescription = typeof lead == "object" && lead?.description ? lead.description : DISPLAY.footer.lead?.description;

const currentPath = getCurrentPath(Astro.url);
---

<footer {...id ? { id } : {}} class:list={[{ dark: isDark }, "not-prose relative border-t border-gray-200 dark:border-slate-800 print:hidden"]}>
	<div class="relative mx-auto max-w-(--content-width) px-4 sm:px-6 dark:text-slate-300">
		<div class="my-auto grid w-full grid-cols-1 gap-4 gap-y-2 py-8 text-center lg:grid-cols-3 lg:py-12 lg:pb-16" class:list={{ "lg:text-start": layout == "narrow" }}>
			<div class:list={layout == "wide" ? "col-span-3" : "col-span-1"}>
				<slot name="lead">
					{
						Astro.slots.has("lead") && typeof lead == "string" && !!lead ? (
							<Fragment set:html={lead} />
						) : leadTitle ? (
							<>
								<h2 class="heading-display text-[clamp(1.4rem,3vw,2.05rem)] font-extrabold!">{leadTitle}</h2>
								{leadDescription && <p class="mt-3.5! text-ink-2">{leadDescription}</p>}
							</>
						) : (
							<>
								<a class="logo-link inline-flex items-center" href={currentPath == "/" ? "#top" : getHomePermalink()}>
									<Logo class="site-logo" />
								</a>
							</>
						)
					}
				</slot>
			</div>
			<div
				class="col-span-3 inline-flex flex-col flex-wrap"
				class:list={{
					"lg:col-span-2 lg:flex-row": layout == "narrow",
					"ml-auto": layout == "narrow" && !actions.length,
				}}
			>
				<div class="inline-flex flex-col items-center lg:mr-4" class:list={{ "lg:items-start": layout == "narrow" }}>
					{
						socialLinks && (
							<SocialLinks
								socialLinks={Array.isArray(socialLinks) ? socialLinks : SOCIALS.toArray()}
								showText={showSocialText}
								showIcon={false || !showSocialText}
								class="gap-2"
								linkClass={showSocialText ? "border border-line rounded-md px-3.5 py-2.5 hover:border-accent hover:text-accent" : "bg-white rounded-md p-2"}
								iconClass={showSocialText ? "w-4 h-4" : "w-8 h-8"}
							/>
						)
					}
					{
						links.map(({ text, href }, index) => (
							<div
								class="text-md mt-2 inline-flex gap-1"
								class:list={{
									"lg:px-2": layout == "narrow",
								}}
							>
								{index !== 0 ? " · " : ""}
								<a class="text-accent transition duration-150 ease-in-out hover:text-gray-700 hover:underline dark:text-gray-400" href={href} set:html={text} />
							</div>
						))
					}
				</div>
				<div
					class="mt-4 flex flex-col items-center"
					class:list={{
						"lg:mt-0 lg:ml-auto": layout == "narrow",
					}}
				>
					<ButtonGroup actions={actions} class="inline-flex" btnClass="py-2.5 px-5.5 md:px-6" />
				</div>
			</div>
		</div>
	</div>
</footer>
