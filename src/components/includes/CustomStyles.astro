		--color-text-muted: var(--c-ink-2);

		--color-bg-page: var(--c-ground);
		--color-bg-page-dark: var(--c-sunk);
		--color-bg-header: var(--c-surface);

		--scroll-progress-bg: var(--c-line);
		--scroll-progress-bar-bg: var(--c-accent);

