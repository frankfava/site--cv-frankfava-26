---
/** A grid of cards, either spaced apart or ruled together into one block. */
import type { _Card } from "@/types";
import { cn } from "@/utils/class";
import { slugify } from "@/utils/str";
import Card from "./Card.astro";
import type { HTMLAttributes } from "astro/types";

export const cardKey = (card: _Card) => card.key ?? slugify(card.title);

export type ColumnCount = 1 | 2 | 3 | 4 | "auto";

/** Column classes for a card grid. `auto` fills to `--column-width`. */
export const gridColumns = (columnCount: ColumnCount): string =>
	({
		1: "",
		2: "sm:grid-cols-2",
		3: "sm:grid-cols-2 xl:grid-cols-3",
		4: "sm:grid-cols-2 xl:grid-cols-4",
		auto: "grid-cols-[repeat(auto-fit,minmax(var(--column-width,300px),1fr))]",
	})[columnCount];

export interface Props<T extends _Card = _Card> {
	class?: HTMLAttributes<"div">["class:list"];
	cards?: T[] | (() => Promise<T[]>);
	spaced?: boolean;
	columnCount?: ColumnCount;
	columnWidth?: string;
	accentColor?: "good" | "bad" | ((card: T) => "good" | "bad" | undefined);
	highlightEyebrow?: boolean;
	borderHighlight?: boolean;
	hoverBorder?: boolean;
	linkText?: string;
}

const {
	class: className,
	cards = [],
	spaced = true,
	columnCount = "auto",
	columnWidth = "300px",
	accentColor: accentColorProp,
	highlightEyebrow = false,
	borderHighlight = highlightEyebrow,
	hoverBorder = false,
	linkText,
} = Astro.props;

/** `T` is not in scope inside the template, so the list is widened here. */
const cardsData: _Card[] = typeof cards === "function" ? await cards() : cards;

type Accent = "good" | "bad" | undefined;
const accentColor: (card: _Card) => Accent = typeof accentColorProp === "function" ? (accentColorProp as (card: _Card) => Accent) : () => accentColorProp;
---

<div
	style={`--column-width: ${columnWidth}`}
	class={cn(
		"cards grid grid-cols-1",
		gridColumns(columnCount),
		{
			"gap-4": spaced,
			"gap-px overflow-hidden rounded-lg border border-line-2 bg-line-2": !spaced,
		},
		className,
	)}
>
	{
		cardsData.map((card) => (
			<Card
				{...{
					card,
					linkText,
					highlightEyebrow,
					borderHighlight,
					accent: accentColor(card),
					class: cn("p-4.5", {
						"rounded-lg border border-line": spaced,
						"transition-colors hover:bg-sunk": !spaced,
						"transition-colors hover:border-accent": hoverBorder,
					}),
				}}
			/>
		))
	}
</div>
