---
import { cn } from "@/utils/class";
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

export interface Props {
	btnText?: string;
	btnClass?: HTMLAttributes<"button">["class:list"];
	modalTitle: string;
	modalDescription?: string;
}

const { btnText = "Open Modal", btnClass, modalTitle = "Modal", modalDescription } = Astro.props;
---

<div x-data="{ modelOpen: false }">
	<div @click="modelOpen =!modelOpen" class="flex">
		<slot name="button">
			<button
				class:list={cn(
					"flex transform items-center justify-center space-x-2 rounded-md bg-indigo-500 px-3 py-2 text-sm tracking-wide text-white capitalize transition-colors duration-200 hover:bg-indigo-600 focus:bg-indigo-500 focus:ring-3 focus:ring-indigo-300/50 focus:outline-none dark:bg-indigo-600 dark:hover:bg-indigo-700 dark:focus:bg-indigo-700",
					btnClass,
				)}
			>
				<span>{btnText}</span>
			</button>
		</slot>
	</div>

	<template x-teleport="body">
		<div x-show="modelOpen" class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
			<div class="flex min-h-screen items-center justify-center px-4 text-center sm:block sm:p-0">
				<div
					x-cloak
					@click="modelOpen = false"
					x-show="modelOpen"
					x-transition:enter="transition ease-out duration-300 transform"
					x-transition:enter-start="opacity-0"
					x-transition:enter-end="opacity-100"
					x-transition:leave="transition ease-in duration-200 transform"
					x-transition:leave-start="opacity-100"
					x-transition:leave-end="opacity-0"
					class="fixed inset-0 z-40 bg-gray-500/40 transition-opacity"
					aria-hidden="true"
				>
				</div>
				<div
					x-cloak
					x-show="modelOpen"
					x-transition:enter="transition ease-out duration-300 transform"
					x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
					x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
					x-transition:leave="transition ease-in duration-200 transform"
					x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
					x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
					class="relative z-50 my-8 inline-block w-full max-w-xl transform overflow-hidden rounded-lg bg-white p-8 text-left shadow-xl transition-all lg:my-24 2xl:max-w-2xl"
				>
					<div class="flex items-center justify-between space-x-4">
						<h1 class="text-xl font-semibold text-gray-800">{modalTitle}</h1>
						<button @click="modelOpen = false" class="text-gray-600 hover:text-gray-700 focus:outline-none">
							<Icon name="ph:x-circle-duotone" class="size-6" />
						</button>
					</div>
					{modalDescription && <p class="mt-2 text-sm text-gray-500">{modalDescription}</p>}
					<div class="mt-5">
						<slot />
					</div>
				</div>
			</div>
		</div>
	</template>
</div>
