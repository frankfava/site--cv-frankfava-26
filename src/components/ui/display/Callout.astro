---
/** A bordered note with a lead label beside it. */
import { cn } from "@/utils/class";
import type { HTMLAttributes } from "astro/types";

export interface Props {
	title?: string;
	class?: string;
	classes?: Partial<{
		outer: HTMLAttributes<"div">["class:list"];
		title: HTMLAttributes<"b">["class:list"];
		content: HTMLAttributes<"p">["class:list"];
	}>;
	variant?: "primary" | "secondary" | "accent" | "default";
}

const { title, class: className, classes, variant = "accent" } = Astro.props;

const variants = {
	primary: "border-l-primary",
	secondary: "border-l-secondary",
	accent: "border-l-accent",
	default: "",
};
---

<div class={cn("callout flex flex-col items-start gap-2.5 border border-l-4 border-line bg-surface px-3.5 py-2.5 text-ink-2 md:flex-row", className, classes?.outer, variants[variant])}>
	{title && <b class={cn("pt-0.5 eyebrow whitespace-nowrap text-accent", classes?.title)}>{title}</b>}
	<p class={cn("m-0", classes?.content)}><slot /></p>
</div>
