---
/** A bordered note with a lead label beside it. */
import { twMerge } from "tailwind-merge";

export interface Props {
	title?: string;
	class?: string;
	titleClass?: string;
}

const { title, class: className, titleClass } = Astro.props;
---

<div class={twMerge("my-5 mb-6 flex max-w-[80ch] items-start gap-2.5 border border-l-4 border-line border-l-accent bg-surface px-3.5 py-2.5 text-ink-2", className)}>
	{title && <b class={twMerge("pt-0.5 eyebrow whitespace-nowrap text-accent", titleClass)}>{title}</b>}
	<p class="m-0"><slot /></p>
</div>
