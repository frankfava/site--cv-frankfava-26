---
import { Icon } from "astro-icon/components";

export interface Props {
	icon?: string;
	subtitle?: string;
	title: string;
	class?: string;
	iconClass?: string;
}

const { icon, subtitle = "You may be wondering...", title, class: className, iconClass } = Astro.props;
---

<div class="flex rounded border border-line bg-surface p-5" class:list={className}>
	{icon && <Icon name={icon} class="me-2 mt-1 inline-block max-h-7 min-h-7 max-w-7 min-w-7" class:list={iconClass} />}
	<div class="grow">
		<div class="italic">{subtitle}</div>
		<h3 class="mb-3 text-lg">
			<span>{title}</span>
		</h3>
		<slot />
	</div>
</div>
