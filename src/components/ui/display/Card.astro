---
/** One card. Its own surface and copy, no layout and no opinion on what wraps it. */
import type { _Card } from "@/types";
import { cn } from "@/utils/class";
import type { HTMLAttributes, HTMLTag } from "astro/types";
import Icon from "node_modules/astro-icon/components/Icon.astro";

export interface Props {
	card: _Card;
	["as"]?: HTMLTag;
	accent?: "good" | "bad";
	highlightEyebrow?: boolean;
	borderHighlight?: boolean;
	linkText?: string;
	class?: HTMLAttributes<any>["class:list"];
}

const { card, as: Tag = "a", accent, highlightEyebrow = false, borderHighlight = false, linkText = card.link?.text, class: className, ...rest } = Astro.props;

/** `Link` allows a URL; a dynamic tag will only take a string. */
const href = Tag === "a" ? card.link?.href?.toString() : undefined;
---

<Tag
	href={href}
	class={cn("card block bg-surface text-left text-ink", className, {
		"rounded-l-none border-l-3": borderHighlight,
		"border-l-good": borderHighlight && accent === "good",
		"border-l-bad": borderHighlight && accent === "bad",
	})}
	{...rest}
>
	{
		card.eyebrow && (
			<span
				class={cn("card--eyebrow mb-2 flex items-center gap-2 eyebrow", {
					"text-ink-3": !highlightEyebrow || !accent,
					"text-good": highlightEyebrow && accent === "good",
					"text-bad": highlightEyebrow && accent === "bad",
				})}
			>
				{card.eyebrowIcon && <Icon name={card.eyebrowIcon} class="size-4" />}
				<span>{card.eyebrow}</span>
			</span>
		)
	}
	<h4 class="card--title mb-1 flex items-center gap-2 text-base">
		{card.titleIcon && <Icon name={card.titleIcon} class="mb-0.5 size-5" />}
		<span>{card.title}</span>
	</h4>
	{card.body && <p class="card--body text-sm text-ink-2">{card.body}</p>}
	{
		card.turn && (
			<p class="card--turn mt-2 border-t border-dashed border-line-2 pt-2 text-sm text-ink-2">
				{card.turnLead && <span class="font-semibold">{card.turnLead}</span>}
				<span class="ml-1">{card.turn}</span>
			</p>
		)
	}
	{linkText && <span class="card--link mt-3 block font-mono text-xs text-accent">{linkText}</span>}
</Tag>
