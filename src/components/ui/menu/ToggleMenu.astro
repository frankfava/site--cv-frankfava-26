---
import { SIDEBAR } from "site:config";
import { twMerge } from "tailwind-merge";

export interface Props {
	label?: string;
	class?: string;
	showLabel?: boolean;
	ariaExpanded?: boolean;
	ariaControls?: string;
	// The `data-*` attribute `main.js` binds to.
	toggleAttr?: string;
}

const { label = "Toggle Menu", showLabel = false, class: className = "", ariaExpanded = false, ariaControls = "bay", toggleAttr = SIDEBAR.toggleAttr } = Astro.props;

const bar = "h-0.5 w-6 my-1 rounded-full bg-black dark:bg-white transition ease transform duration-200 opacity-80";
---

<button
	type="button"
	class={twMerge("group flex cursor-pointer flex-col items-center justify-center rounded", className)}
	aria-label={label}
	aria-expanded={ariaExpanded ? "true" : "false"}
	aria-controls={ariaControls}
	{...{ [toggleAttr]: "" }}
>
	<slot>
		<span aria-hidden="true" class={`${bar} in-[html.nav-menu-open]:rotate-45 in-[html.nav-menu-open]:translate-y-2.5`}></span>
		<span aria-hidden="true" class={`${bar} in-[html.nav-menu-open]:opacity-0`}></span>
		<span aria-hidden="true" class={`${bar} in-[html.nav-menu-open]:-rotate-45 in-[html.nav-menu-open]:-translate-y-2.5`}></span>
	</slot>
	<span class={showLabel ? "" : "sr-only"}>{label}</span>
</button>
