---
import { Icon } from "astro-icon/components";
---

<a
	id="scroll-to-top"
	href="#"
	class="right-4 bottom-0 z-10! fixed flex justify-center items-center bg-surface hover:bg-accent shadow-(--c-shadow) p-3 border border-line hover:border-accent rounded-md text-ink-2 hover:text-white transition-all duration-250 ease-linear invisible hover:animate-none opacity-0 print:hidden [&.active]:bottom-4 [&.active]:opacity-100 [&.active]:visible"
>
	<Icon name="ph:arrow-fat-up" class="w-5 h-5" />
</a>

<script>
	function initScrollTop() {
		const scrollToTop = document.getElementById("scroll-to-top") as HTMLElement;

		scrollToTop.addEventListener("click", () => {
			window.scrollTo(0, 0);
		});

		function onWindowScroll() {
			if (window.scrollY > 150) {
				scrollToTop.classList.add("active");
			} else {
				scrollToTop.classList.remove("active");
			}
		}
		window.addEventListener("scroll", onWindowScroll);
		onWindowScroll();
	}

	document.addEventListener("astro:after-swap", initScrollTop);
	initScrollTop();
</script>

<style>
	/* Keyframes are the one thing here a utility cannot express. The ring is the
	   accent at low alpha, so it reads in both colour modes. */
	@keyframes scrollPulse {
		0% {
			box-shadow: 0 0 0 0 rgba(var(--c-accent-rgb), 0.4);
		}
		70% {
			box-shadow: 0 0 0 10px rgba(var(--c-accent-rgb), 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(var(--c-accent-rgb), 0);
		}
	}

	#scroll-to-top.active {
		animation: scrollPulse 2s forwards infinite;
	}
</style>
