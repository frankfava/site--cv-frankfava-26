---
import { Icon } from "astro-icon/components";
import type { Link } from "@/types";
import { cn } from "@/utils/class";
import type { HTMLAttributes } from "astro/types";
import type { AstroVNode } from "astro/jsx-runtime";

export interface Props extends Link {
	"class:list"?: HTMLAttributes<"li">["class:list"];
	showLinkIcon?: boolean;
	linkClass?: HTMLAttributes<"a">["class:list"];
	iconClass?: string;
	lead?: (props: Omit<Props, "lead">) => AstroVNode;
}

const { text, href, icon, showLinkIcon = true, "class:list": classList, class: className = "", linkClass = "", iconClass = "", lead, ...anchorAttrs } = Astro.props;

const leadProps = Astro.props;
delete leadProps.lead;
---

<li class={className} class:list={cn(classList)}>
	<a class={cn(["border border-transparent text-ink hover:text-accent dark:hover:text-white px-1 lg:px-3 py-1 flex text-wrap items-center", linkClass])} href={href} {...anchorAttrs}>
		<slot name="lead">
			{lead ? lead(leadProps) : showLinkIcon && icon && <Icon name={icon} class={cn("w-5 h-5 mr-3", iconClass)} />}
		</slot>
		<span class="grow">{text}</span>
	</a>
	<slot />
</li>
