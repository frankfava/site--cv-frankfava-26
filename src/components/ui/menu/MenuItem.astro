---
import { Icon } from "astro-icon/components";
import type { Link } from "@/types";
import { twMerge } from "tailwind-merge";
import { cn } from "@/utils/class";
import type { HTMLAttributes } from "astro/types";

export interface Props extends Link {
	showLinkIcon?: boolean;
	linkClass?: HTMLAttributes<"a">["class:list"];
	iconClass?: string;
}

const { text, href, icon, showLinkIcon = true, class: className = "", linkClass = "", iconClass = "", ...anchorAttrs } = Astro.props;
---

<li class:list={[className]}>
	<a class={cn(["border border-transparent text-ink hover:text-accent dark:hover:text-white px-1 lg:px-3 py-1 flex text-wrap items-center", linkClass])} href={href} {...anchorAttrs}>
		{showLinkIcon && icon && <Icon name={icon} class={twMerge("w-5 h-5 mr-3", iconClass)} />}
		<slot name="lead" />
		<span class="grow">{text}</span>
	</a>
	<slot />
</li>
