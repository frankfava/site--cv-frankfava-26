---
import type { Socials } from "@/types";
import { Icon } from "astro-icon/components";
import { twMerge } from "tailwind-merge";

export interface Props extends Socials.Link {
	showText?: boolean;
	class?: string;
	linkClass?: string;
	iconClass?: string;
	content?: string;
	[key: string]: any;
}

const { label, icon, href, text, showText = true, class: className, linkClass, iconClass, content = await Astro.slots.render("content"), ...rest } = Astro.props;
---

<a
	class={twMerge(
		"inline-flex items-center gap-x-2 rounded-lg border border-primary-100 bg-gray-100 p-2.5 text-sm text-primary-900 transition-colors duration-200 hover:border-accent-200 hover:bg-accent-100 hover:text-accent focus:ring-2 focus:ring-gray-200 focus:outline-none dark:border-primary-500 dark:bg-primary-600 dark:text-white dark:hover:border-primary-600 dark:hover:bg-primary-700 dark:hover:text-white dark:focus:ring-gray-700",
		linkClass,
		className,
	)}
	aria-label={label ?? text}
	title={label ?? text}
	href={href}
	target="_blank"
	{...rest}
>
	{
		Astro.slots.has("content") && content && typeof content == "string" ? (
			<Fragment set:html={content} />
		) : (
			<>
				{icon && <Icon name={icon} class={twMerge("size-5", iconClass)} />}
				{showText && <Fragment set:html={label ?? text} />}
			</>
		)
	}
</a>
