---
import type { Socials } from "@/types";
import { Icon } from "astro-icon/components";
import { twMerge } from "tailwind-merge";

export interface Props extends Socials.Link {
	showText?: boolean;
	class?: string;
	linkClass?: string;
	iconClass?: string;
	content?: string;
	[key: string]: any;
}

const { label, icon, href, text, showText = true, class: className, linkClass, iconClass, content = await Astro.slots.render("content"), ...rest } = Astro.props;
---

<a
	class={twMerge(
		"inline-flex items-center rounded-lg text-sm p-2.5 transition-colors duration-200 text-primary-900 hover:text-accent dark:text-white dark:hover:text-white bg-gray-100 hover:bg-accent-100 dark:bg-primary-600 dark:hover:bg-primary-700 border border-primary-100 hover:border-accent-200 dark:border-primary-500 dark:hover:border-primary-600 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:focus:ring-gray-700 gap-x-2",
		linkClass,
		className,
	)}
	aria-label={label ?? text}
	title={label ?? text}
	href={href}
	target="_blank"
	{...rest}
>
	{
		Astro.slots.has("content") && content && typeof content == "string" ? (
			<Fragment set:html={content} />
		) : (
			<>
				{icon && <Icon name={icon} class={twMerge("w-5 h-5", iconClass)} />}
				{showText && <Fragment set:html={label ?? text} />}
			</>
		)
	}
</a>
