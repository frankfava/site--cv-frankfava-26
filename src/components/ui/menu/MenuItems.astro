---
import type { Link } from "@/types";
import MenuItem from "./MenuItem.astro";

import { trimSlash } from "@/utils/permalinks";

export interface Props {
	links?: Array<Link>;
	showLinkIcons?: boolean;
	itemClass?: string;
	linkClass?: string;
	iconClass?: string;
}

const { links = [], showLinkIcons = true, itemClass, linkClass, iconClass } = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

const visibleLinks = links.filter((link) => {
	const showOn = (Array.isArray(link?.showOn) ? link?.showOn : [link?.showOn ?? ""]).filter(Boolean);
	return !showOn.length ? true : showOn.includes(currentPath);
});
---

{
	visibleLinks.map((link) => (
		<MenuItem
			{...{
				...link,
				currentPath,
				showLinkIcon: showLinkIcons,
				itemClass,
				linkClass,
				iconClass,
			}}
		/>
	))
}
