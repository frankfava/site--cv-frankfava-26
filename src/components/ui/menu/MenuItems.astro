---
import type { Link } from "@/types";
import MenuItem from "./MenuItem.astro";
import type { HTMLAttributes } from "astro/types";

export interface Props {
	links?: Array<Link>;
	showLinkIcons?: boolean;
	itemClass?: string;
	linkClass?: HTMLAttributes<"a">["class:list"] | ((link: Link) => HTMLAttributes<"a">["class:list"]);
	iconClass?: string;
	filterLinks?: (link: Link) => boolean;
}

const { links = [], showLinkIcons = true, itemClass, linkClass, iconClass, filterLinks } = Astro.props;

const filteredLinks = filterLinks ? links.filter(filterLinks) : links;
---

{
	filteredLinks.map((link) => (
		<MenuItem
			{...{
				...link,
				showLinkIcon: showLinkIcons,
				class: [link.class, itemClass].filter(Boolean).join(" "),
				linkClass: typeof linkClass === "function" ? linkClass(link) : linkClass,
				iconClass,
			}}
		/>
	))
}
