---
/**
 * The jump rail. Fixed to the right of the screen.
 * Shown only when there are links to display and the sidebar is not in use on desktop.
 *
 * `links` are only displayed when a blueprint is not in use.
 */
import { BlueprintBuilder } from "@/lib/blueprints";
import type { Link } from "@/types";

export interface Props {
	links?: Link[];
}

const { links } = Astro.props;

const blueprintSchema = Astro.locals.blueprint?.blueprint;
const blueprintSections = blueprintSchema?.getSidebarSections();
const blueprintSectionLinks = BlueprintBuilder.menuLinks(blueprintSections ?? []);

const useLinks = blueprintSectionLinks ?? links;
---

{
	!!useLinks.length && (
		<nav class="rail top-1/2 right-5 z-65 fixed flex-col gap-1 -translate-y-1/2" aria-label="Page sections">
			{useLinks.map((link) => (
				<a href={link.href} class="group relative flex justify-end items-center px-1 py-2 text-ink-3! transition-all duration-160 ease-[ease]" data-section-link>
					<span class="absolute right-full mr-3 rounded-full border border-line bg-surface px-3 py-2 text-[0.86rem] text-ink)! whitespace-nowrap opacity-0 translate-x-1.45 pointer-events-none shadow-[0_8px_22px_-16px_rgba(0,0,0,0.6)] transition-all duration-180 ease-[ease] group-hover:opacity-100 group-hover:translate-x-0 group-focus-visible:opacity-100 group-focus-visible:translate-x-0 group-[.is-on]:opacity-100 group-[.is-on]:translate-x-0">
						{link.text}
					</span>
					<i class="w-2.5 h-2.5 flex-none rounded-[50%] border-[1.5px] border-ink-3 bg-ground transition-all duration-180 ease-[ease] group-hover:border-accent group-[.is-on]:border-accent group-[.is-on]:bg-accent group-[.is-on]:scale-[1.15]" />
				</a>
			))}
		</nav>
	)
}
