---
import type { _ModuleHeader as Props } from "@/types";
import Button from "@/components/ui/input/Button.astro";
import { cn } from "@/utils/class";

const { title = await Astro.slots.render("title"), subtitle = await Astro.slots.render("subtitle"), eyebrow, headerAlign = "left", stacked = true, classes = {}, cta: callToAction } = Astro.props;
---

{
	(title || subtitle) && (
		<div
			class={cn(
				"module--header w-full",
				stacked ? "" : `w-full items-end gap-6 lg:flex`,
				{
					"text-center": headerAlign == "center",
					"text-left": headerAlign == "left",
					"text-right": headerAlign == "right",
				},
				classes?.container,
			)}
		>
			<div
				class:list={{
					"grow lg:max-w-[70%]": !stacked,
				}}
			>
				<slot name="beforeHeader" />
				{eyebrow && <span class={cn("mb-2 block eyebrow text-accent", classes?.eyebrow)}>{eyebrow}</span>}
				{title && <h2 class={cn("module--heading font-heading text-heading leading-tighter text-2xl font-semibold tracking-tighter lg:text-3xl", classes?.title)} set:html={title} />}

				{subtitle && (
					<div class={cn("module--subtitle mt-2 text-lg text-gray-500 dark:text-slate-400", classes?.subtitle)}>
						{subtitle && Astro.slots.has("subtitle") ? <Fragment set:html={subtitle} /> : <p class="my-0 text-gray-500" set:html={subtitle} />}
					</div>
				)}
				<slot name="afterHeader" />
			</div>
			{callToAction && (
				<div class="module--cta mt-4" class:list={{ "lg:ml-auto": !stacked }}>
					<div class={cn("inline-flex justify-center font-semibold", classes?.cta)}>
						<Button
							{...{
								class: cn("text-sm", classes?.ctaBtn),
								variant: "primary",
								...callToAction,
							}}
						/>
					</div>
				</div>
			)}
		</div>
	)
}
