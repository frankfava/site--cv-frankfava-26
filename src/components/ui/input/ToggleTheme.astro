---
/**
 * Colour mode control.
 *
 * `variant` filters the options rather than changing the markup: `menu` offers
 * all three and opens a list, `single` keeps light and dark only and flips
 * straight between them. Both drive the same `themeToggle` component, so a
 * visitor who picked `system` keeps it.
 */
import { THEME } from "site:config";
import { Icon } from "astro-icon/components";
import { cn } from "@/utils/class";
import type { HTMLAttributes } from "astro/types";
import type { AstroVNode } from "astro/jsx-runtime";

type OptionKey = "light" | "dark" | "system";
type ThemeOption = { key: OptionKey; label: string };

export interface Props {
	label?: string;
	class?: HTMLAttributes<"button">["class:list"];
	activeIconClass?: HTMLAttributes<any>["class:list"];
	activeIcon?: Partial<Record<OptionKey, string>> | ((option: ThemeOption & { activeIconClass: HTMLAttributes<any>["class:list"] }) => AstroVNode);
	menuIcon?: Partial<Record<OptionKey, string>> | ((option: ThemeOption) => AstroVNode);
	variant?: "menu" | "single";
}

const icons = { light: "ph:sun", dark: "ph:moon-stars", system: "ph:desktop" } as Record<OptionKey, string>;

const { label = "Toggle between Dark and Light mode", class: className = "", activeIconClass = "", activeIcon = icons, menuIcon = icons, variant = "menu" } = Astro.props;

const options = [
	{ key: "light", label: "Light" },
	{ key: "dark", label: "Dark" },
	{ key: "system", label: "System" },
] as ThemeOption[];

/** With nothing to choose between, the trigger is the choice. */
const resolvedOptions = options.filter((o) => variant !== "single" || o.key !== "system");
const isSingle = resolvedOptions.length < 3;

const resolvedActiveIcon = typeof activeIcon === "function" ? Object.fromEntries(options.map((o) => [o.key, activeIcon({ ...o, activeIconClass }) ?? icons[o.key]])) : activeIcon;

const resolvedMenuIcon = typeof menuIcon === "function" ? Object.fromEntries(options.map((o) => [o.key, menuIcon(o) ?? icons[o.key]])) : menuIcon;
---

{
	!(THEME.default && THEME.default.endsWith(":only")) && (
		<div x-data="themeToggle" data-theme={THEME.default} data-options={resolvedOptions.map((o) => o.key).join(",")} class="relative flex">
			<button
				type="button"
				@click={isSingle ? "toggle()" : "toggleOpen()"}
				class={cn(
					"inline-flex items-center rounded-lg border p-2.5 text-sm text-gray-600 transition-colors duration-200 focus:ring-2 focus:ring-gray-200 focus:outline-none dark:border-gray-600 dark:text-white dark:focus:ring-gray-700",
					className,
				)}
				aria-label={label}
				x-bind:aria-label={isSingle ? "label" : undefined}
				aria-haspopup={isSingle ? undefined : "true"}
				x-bind:class={isSingle ? undefined : "isOpen ? 'text-neutral-900 dark:text-white' : 'text-neutral-600 dark:text-neutral-300'"}
				x-bind:aria-expanded={isSingle ? undefined : "isOpen"}
			>
				{resolvedOptions.map((o) => (
					<>
						{typeof resolvedActiveIcon[o.key] === "string" ? (
							<Icon x-show={`isActive('${o.key}')`} name={resolvedActiveIcon[o.key]} class={cn("toggle-icon size-4", o.key, activeIconClass)} />
						) : (
							<Fragment set:html={resolvedActiveIcon[o.key]} />
						)}
					</>
				))}
			</button>
			{!isSingle && (
				<div
					x-cloak
					x-show="isOpen"
					x-transition
					@click.outside="close()"
					@keydown.down.prevent="$focus.wrap().next()"
					@keydown.up.prevent="$focus.wrap().previous()"
					class="absolute top-14 right-0 z-10! w-30 divide-y divide-gray-100 overflow-hidden rounded-lg bg-white py-1 text-sm font-semibold text-primary-700 shadow-xl ring-1 ring-gray-100 dark:bg-gray-700 dark:text-primary-300 dark:ring-gray-600"
					role="menu"
				>
					<ul class="py-2 text-sm text-gray-700 dark:text-gray-200" role="listbox" tabindex="0" aria-orientation="vertical">
						{resolvedOptions.map((o) => (
							<li
								@click={`select('${o.key}')`}
								class="active flex cursor-pointer items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
								role="option"
								tabindex="-1"
							>
								<>
									{typeof resolvedMenuIcon[o.key] === "string" ? (
										<Icon name={resolvedMenuIcon[o.key]} class="mr-3 size-6 dark:fill-white" />
									) : (
										<Fragment set:html={resolvedMenuIcon[o.key]} />
									)}
								</>
								<span>{o.label}</span>
							</li>
						))}
					</ul>
				</div>
			)}
		</div>
	)
}
