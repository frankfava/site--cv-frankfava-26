---
/**
 * Colour mode control.
 *
 * `variant` filters the options rather than changing the markup: `menu` offers
 * all three and opens a list, `single` keeps light and dark only and flips
 * straight between them. Both drive the same `themeToggle` component, so a
 * visitor who picked `system` keeps it.
 */
import { THEME } from "site:config";
import { Icon } from "astro-icon/components";
import { cn } from "@/utils/class";
import type { HTMLAttributes } from "astro/types";
import SwitchCase from "../display/SwitchCase.astro";

type OptionKey = "light" | "dark" | "system";
type ThemeOption = { key: OptionKey; icon: string; label: string };

export interface Props {
	label?: string;
	class?: HTMLAttributes<"button">["class:list"];
	actveIconClass?: HTMLAttributes<any>["class:list"];
	// activeIcon?: Partial<Record<OptionKey, string | ((key: OptionKey) => AstroVNode)>>;
	activeIcon?: Partial<Record<OptionKey, string>>;
	menuIcon?: Partial<Record<OptionKey, string>>;
	variant?: "menu" | "single";
}

const {
	label = "Toggle between Dark and Light mode",
	class: className = "",
	actveIconClass = "",
	activeIcon = {
		light: "ph:sun",
		dark: "ph:moon-stars",
		system: "ph:desktop",
	},
	menuIcon = activeIcon,
	variant = "menu",
} = Astro.props;

const options = [{ key: "light", label: "Light" }, { key: "dark", label: "Dark" }, ...(variant !== "single" ? [{ key: "system", label: "System" }] : [])] as ThemeOption[];

/** With nothing to choose between, the trigger is the choice. */
const isSingle = options.length < 3;
---

{
	!(THEME.default && THEME.default.endsWith(":only")) && (
		<div x-data="themeToggle" data-theme={THEME.default} data-options={options.map((o) => o.key).join(",")} class="relative flex">
			<button
				type="button"
				@click={isSingle ? "toggle()" : "toggleOpen()"}
				class={cn(
					"inline-flex items-center rounded-lg border p-2.5 text-sm text-gray-600 transition-colors duration-200 focus:ring-2 focus:ring-gray-200 focus:outline-none dark:border-gray-600 dark:text-white dark:focus:ring-gray-700",
					className,
				)}
				aria-label={label}
				x-bind:aria-label={isSingle ? "label" : undefined}
				aria-haspopup={isSingle ? undefined : "true"}
				x-bind:class={isSingle ? undefined : "isOpen ? 'text-neutral-900 dark:text-white' : 'text-neutral-600 dark:text-neutral-300'"}
				x-bind:aria-expanded={isSingle ? undefined : "isOpen"}
			>
				{options.map(({ key }) => (
					<SwitchCase value={key}>
						<Icon slot="default" x-show={`isActive('${key}')`} name={activeIcon[key]} class={cn("toggle-icon size-6", key, actveIconClass)} />
					</SwitchCase>
				))}
			</button>
			{!isSingle && (
				<div
					x-cloak
					x-show="isOpen"
					x-transition
					@click.outside="close()"
					@keydown.down.prevent="$focus.wrap().next()"
					@keydown.up.prevent="$focus.wrap().previous()"
					class="absolute top-14 right-0 z-10! w-30 divide-y divide-gray-100 overflow-hidden rounded-lg bg-white py-1 text-sm font-semibold text-primary-700 shadow-xl ring-1 ring-gray-100 dark:bg-gray-700 dark:text-primary-300 dark:ring-gray-600"
					role="menu"
				>
					<ul class="py-2 text-sm text-gray-700 dark:text-gray-200" role="listbox" tabindex="0" aria-orientation="vertical">
						{options.map(({ key, label }) => (
							<li
								@click={`select('${key}')`}
								class="active flex cursor-pointer items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
								role="option"
								tabindex="-1"
							>
								<SwitchCase value={key}>
									<Icon slot="default" name={menuIcon[key]} class="mr-3 size-6 dark:fill-white" />
								</SwitchCase>
								<span>{label}</span>
							</li>
						))}
					</ul>
				</div>
			)}
		</div>
	)
}
