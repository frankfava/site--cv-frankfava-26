---
import { Icon } from "astro-icon/components";
import { twMerge } from "tailwind-merge";
import type { _CallToAction as Props } from "@/types";

const { variant = "accent", target, text = Astro.slots.render("default"), icon = "", class: className = "", type, ...rest } = Astro.props;

const variants = {
	primary: "btn-primary",
	primaryOutline: "btn-outline-primary",
	secondary: "btn-secondary",
	secondaryOutline: "btn-outline-secondary",
	accent: "btn-accent",
	accentOutline: "btn-outline-accent",
	tertiary: "btn-tertiary",
	link: "cursor-pointer hover:text-primary",
};
---

{
	type === "button" || type === "submit" || type === "reset" ? (
		<button type={type} class={twMerge(variants[variant] || "", className)} {...rest}>
			<Fragment set:html={text} />
			{icon && <Icon name={icon} class="inline-block -mr-1.5 rtl:mr-1 ml-1 rtl:-ml-1.5 w-5 h-5" />}
		</button>
	) : (
		<a class={twMerge(variants[variant] || "", className)} {...(target ? { target: target, rel: "noopener noreferrer" } : {})} {...rest}>
			<Fragment set:html={text} />
			{icon && <Icon name={icon} class="inline-block -mr-1.5 rtl:mr-1 ml-1 rtl:-ml-1.5 w-5 h-5" />}
		</a>
	)
}
