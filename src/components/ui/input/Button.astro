---
import { Icon } from "astro-icon/components";
import type { _CallToAction as Props } from "@/types";
import { cn } from "@/utils/class";

const { variant = "accent", target, text = Astro.slots.render("default"), icon = "", class: className = "", classes, type, ...rest } = Astro.props;

const variants = {
	primary: "btn-primary",
	primaryOutline: "btn-outline-primary",
	secondary: "btn-secondary",
	secondaryOutline: "btn-outline-secondary",
	accent: "btn-accent",
	accentOutline: "btn-outline-accent",
	tertiary: "btn-tertiary",
	link: "cursor-pointer hover:text-(--c-link-hover)",
};
---

{
	type === "button" || type === "submit" || type === "reset" ? (
		<button type={type} class={cn(variants[variant] || "", className, classes?.outer)} {...rest}>
			<span set:html={text} class:list={classes?.text} />
			{icon && <Icon name={icon} class={cn("-mr-1.5 ml-1 inline-block size-5 rtl:mr-1 rtl:-ml-1.5", classes?.icon)} />}
		</button>
	) : (
		<a class={cn(variants[variant] || "", className, classes?.outer)} {...(target ? { target: target, rel: "noopener noreferrer" } : {})} {...rest}>
			<span set:html={text} class:list={classes?.text} />
			{icon && <Icon name={icon} class={cn("-mr-1.5 ml-1 inline-block size-5 rtl:mr-1 rtl:-ml-1.5", classes?.icon)} />}
		</a>
	)
}
