---
import type { _CallToAction } from "@/types";
import Button from "./Button.astro";
import { cn } from "@/utils/class";
import type { HTMLAttributes } from "astro/types";

export interface Props {
	class?: string;
	actions?: Array<_CallToAction>;
	btnClass?: HTMLAttributes<"button" | "a">["class:list"];
}

const { actions = [], class: className = "", btnClass } = Astro.props;
---

{
	actions.length ? (
		<div class={cn("flex gap-2", className)}>
			{actions.filter(Boolean).map((btnProps) => (
				<Button {...btnProps} class={cn("w-auto", btnClass)} />
			))}
		</div>
	) : (
		""
	)
}
