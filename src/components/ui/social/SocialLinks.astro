---
import type { Socials } from "@/types";
import SocialLinkButton, { type Props as SocialLinkButtonProps } from "./SocialLinkButton.astro";
import type { HTMLAttributes } from "astro/types";

export interface Props extends Pick<SocialLinkButtonProps, "showText" | "linkClass" | "iconClass" | "suffixIconClass"> {
	class?: HTMLAttributes<"ul">["class:list"];
	socialLinks: Socials.Link[];
	showIcon?: boolean;
}

const { socialLinks = [], showText = true, showIcon = true, class: className, linkClass, iconClass, suffixIconClass } = Astro.props;
---

<>
	{
		socialLinks?.length && (
			<ul class:list={["social-links inline-flex flex-wrap items-center", className]}>
				{socialLinks.map(({ icon, suffixIcon, ...rest }) => (
					<li class="flex">
						<SocialLinkButton
							{...{
								...rest,
								showText,
								linkClass,
								icon: showIcon ? icon : undefined,
								suffixIcon: showIcon ? suffixIcon : undefined,
								iconClass,
								suffixIconClass,
							}}
						/>
					</li>
				))}
			</ul>
		)
	}
</>
