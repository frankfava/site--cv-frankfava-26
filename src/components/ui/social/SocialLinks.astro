---
import type { Socials } from "@/types";
import { twMerge } from "tailwind-merge";
import SocialLinkButton from "./SocialLinkButton.astro";

export interface Props {
	socialLinks: Socials.Link[];
	showText?: boolean;
	showIcon?: boolean;
	class?: string;
	linkClass?: string;
	iconClass?: string;
}

const { socialLinks = [], showText = true, showIcon = true, class: className, linkClass, iconClass } = Astro.props;
---

<>
	{
		socialLinks?.length && (
			<ul class={twMerge("inline-flex flex-wrap items-center", className)}>
				{socialLinks.map(({ href, icon, label, text, class: className, suffixIcon, ...rest }) => (
					<li class="flex">
						<SocialLinkButton {...{ href, icon: showIcon ? icon : undefined, label, text, class: className ?? "", linkClass, iconClass, showText, ...rest }} />
					</li>
				))}
			</ul>
		)
	}
</>
