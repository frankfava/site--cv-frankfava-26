---
/**
 * A button that toggles the sidebar.
 */
import { cn } from "@/utils/class";

import ToggleMenu, { type Props as ToggleMenuProps } from "@/components/ui/menu/ToggleMenu.astro";

export interface Props extends ToggleMenuProps {}

const { label = "Index", showLabel = true, class: className, ariaExpanded, ariaControls, toggleAttr } = Astro.props;
---

<ToggleMenu
	class={cn(
		`flex-row gap-2.5 rounded-lg border border-line bg-none px-3 py-2.5 pl-2.5 font-secondary text-sm leading-none text-ink-2 transition-all duration-150 hover:border-accent hover:text-accent`,
		className,
	)}
	{showLabel}
	{label}
	{ariaExpanded}
	{ariaControls}
	{toggleAttr}
>
	<svg class="size-4.5 flex-none" viewBox="0 0 20 20" fill="none" aria-hidden="true">
		<rect x="1.5" y="3.5" width="17" height="13" rx="2.5" stroke="currentColor" stroke-width="1.5"></rect>
		<rect
			class="opacity-90 transition-opacity duration-250 ease-[cubic-bezier(0.3,0.8,0.3,1)] in-[html:not(.nav-menu-open)]:opacity-35"
			x="1.5"
			y="3.5"
			width="6.5"
			height="13"
			rx="2.5"
			fill="currentColor"></rect>
	</svg>
</ToggleMenu>
