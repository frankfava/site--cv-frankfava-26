---
/**
 * The index bay. Off-canvas below the shell breakpoint, pinned beside the
 * content above it;
 *
 * `navLinks` display the same links that are passed to the header
 * `links` are only displayed when a blueprint is not in use.
 */

import type { Link } from "@/types";

import { SOCIALS } from "site:config";
import BayLinkCard, { type Props as BayLinkCardProps } from "./cards/BayLinkCard.astro";
import SocialLinks from "@/components/ui/menu/SocialLinks.astro";
import type { AstroVNode } from "astro/jsx-runtime";

export interface Props {
	showSocialLinks?: boolean;
	showNavLinks?: boolean;
	navLinks?: Array<Link>;
	links?: BayLinkCardProps["links"];
	useNestedLinks?: BayLinkCardProps["useNestedLinks"];
	linkLeadType?: BayLinkCardProps["lead"];
	append?: (links: Link[]) => AstroVNode;
}

const { showSocialLinks = true, showNavLinks = false, navLinks = [], links = [], useNestedLinks = true, linkLeadType, append } = Astro.props;

const blueprintSchema = Astro.locals.blueprint?.blueprint;
const blueprintSections = blueprintSchema?.getSidebarSections();

// Convert blueprint sections to links
const blueprintSectionLinks = blueprintSections
	?.map((section) => {
		if (section?.hidden && !section.hasSections()) {
			return undefined;
		}
		return {
			...section.convertToMenuLink({ id: null }),
			href: section.hidden ? section.getFirstSection()?.convertToMenuLink()?.href : section.convertToMenuLink()?.href,
			children: section.hasSections() ? section.sections?.map((section) => section.convertToMenuLink({ id: null })) : undefined,
		};
	})
	.filter(Boolean) as BayLinkCardProps["links"];

const useLinks = blueprintSectionLinks ?? links;
---

<aside
	class="bay flex flex-col gap-5 fixed inset-y-0 top-(--header-height) -left-full z-60 w-full max-w-105 overflow-y-auto overscroll-contain border-r border-line bg-ground p-[18px_20px_40px] transition-[left] duration-220 ease-[cubic-bezier(0.3,0.8,0.3,1)] in-[html.nav-menu-open]:left-0 lg:sticky lg:bottom-auto lg:top-(--header-height) lg:left-auto lg:z-auto lg:w-(--sidebar-width) lg:max-w-none lg:h-[calc(100vh-var(--header-height))] lg:overflow-x-hidden lg:overflow-y-auto lg:overscroll-auto lg:bg-sunk lg:p-[30px_26px_44px] lg:transition-[opacity,transform] lg:duration-300"
	id="bay"
	data-sidebar-bay
>
	{
		showSocialLinks && (
			<div id="sidebar-social" class="text-center">
				<SocialLinks slot="actions" socialLinks={SOCIALS.toArray()} showText={false} class="gap-1" linkClass="rounded-lg p-2 bg-surface" iconClass="w-6 h-6" />
			</div>
		)
	}

	{showNavLinks && !!navLinks.length && <BayLinkCard id="nav-links" class="lg:hidden" title="Links" links={navLinks as BayLinkCardProps["links"]} />}

	{
		!!useLinks.length && (
			<BayLinkCard {...{ title: "On this page", id: "index-nav", navClass: "toc", useNestedLinks, links: useLinks, lead: linkLeadType }}>
				<span class="tab ml-auto font-mono text-[0.72rem] text-accent" slot="meta" data-cv-progress>
					0%
				</span>
			</BayLinkCard>
		)
	}

	<slot name="end">
		{append ? append?.(useLinks) : null}
	</slot>
</aside>
