---
import { Icon } from "astro-icon/components";
import { resolveSearchSettings, type SearchIndexEntry } from "@/lib/search";

export interface Props {
	showHint?: boolean;
	/** The index this page's dialog queries, resolved by the layout from the blueprint. */
	index: SearchIndexEntry;
}

const { showHint = true, index } = Astro.props;

const indexUrl = `/api/search-index/${index.slug}.json`;
const { hotkey, placeholder, emptyMessage } = resolveSearchSettings(index);
---

<>
	{
		showHint && (
			<div id="search-hint" search-toggle class="fixed bottom-0 z-2 w-full cursor-pointer border-t border-line bg-surface py-1.5 text-center leading-1 text-ink-2 print:hidden">
				<span class="hidden items-center justify-center gap-x-1.5 sm:flex">
					Press
					<kbd data-search-mod-key class="pointer-events-none rounded border border-line bg-sunk px-1.5 text-sm text-ink-3 select-none">
						{"⌘"}
					</kbd>
					+
					<kbd data-search-activation-key class="pointer-events-none rounded border border-line bg-sunk px-1.5 text-sm text-ink-3 select-none">
						{hotkey}
					</kbd>
					to open the search panel.
				</span>
				<span class="flex items-center justify-center gap-x-1.5 sm:hidden">
					Press
					<kbd class="pointer-events-none rounded border border-line bg-sunk px-1.5 text-sm text-ink-3 select-none">here</kbd>
					to open the search panel.
				</span>
			</div>
		)
	}
	<dialog
		id="search-dialog"
		data-index-url={indexUrl}
		data-empty-message={emptyMessage}
		data-hotkey={hotkey}
		transition:persist
		class="fixed inset-0 z-200 m-0 size-full max-h-full max-w-full bg-transparent p-0 backdrop:bg-black/50"
	>
		<div class="relative mx-auto mt-[5vh] max-w-lg overflow-hidden rounded-md border border-line bg-surface shadow-2xl md:mt-[10vh]">
			<div class="flex items-center gap-3 border-b border-line px-4 py-3">
				<Icon name="ph:magnifying-glass" class="size-5 shrink-0 text-muted" />
				{
					/* `appearance-none` plus the focus-visible resets suppress the browser
				   and Tailwind focus rings, so the input reads as part of the bar rather
				   than sitting in its own outlined box. */
				}
				<input
					id="search-input"
					type="text"
					placeholder={placeholder}
					autocomplete="off"
					class="flex-1 appearance-none border-none bg-transparent text-[15px] text-ink outline-hidden placeholder:text-muted focus:outline-none focus-visible:ring-0 focus-visible:outline-none"
				/>
				<button id="search-close" search-toggle-close class="cursor-pointer p-1 text-bad hover:text-ink-2 md:hidden" aria-label="Close">
					<Icon name="ph:x-circle" class="size-8" />
				</button>
			</div>
			<div id="search-results" class="max-h-[50vh] overflow-y-auto md:max-h-[60vh]">
				<div class="px-4 py-8 text-center text-[13px] text-muted">{emptyMessage}</div>
			</div>
			{
				/* The mod-key and activation kbds carry the same `data-search-*` hooks as
				   the page-bottom hint, so one sweep updates both. */
			}
			<div class="hidden items-center justify-between gap-3 border-t border-line px-4 py-2 text-[11px] text-muted md:flex">
				<div class="flex items-center gap-1.5">
					<kbd class="rounded border border-line bg-sunk px-1.5 py-0.5 text-muted">↵</kbd>
					<span>to select</span>
				</div>
				<div class="flex items-center gap-1.5">
					<kbd class="rounded border border-line bg-sunk px-1.5 py-0.5 text-muted">↑</kbd>
					<kbd class="rounded border border-line bg-sunk px-1.5 py-0.5 text-muted">↓</kbd>
					<span>to navigate</span>
				</div>
				<div class="flex items-center gap-1.5">
					<kbd data-search-mod-key class="rounded border border-line bg-sunk px-1.5 py-0.5 text-muted">{"⌘"}</kbd>
					<kbd data-search-activation-key class="rounded border border-line bg-sunk px-1.5 py-0.5 text-muted">{hotkey}</kbd>
					<span>or</span>
					<kbd class="rounded border border-line bg-sunk px-1.5 py-0.5 text-muted">Esc</kbd>
					<span>to close</span>
				</div>
			</div>
		</div>
	</dialog>
	<template id="search-result-template">
		<a data-search-result data-active="false" href="" class="flex items-start gap-3 border-b border-line px-4 py-3 transition-colors last:border-0 hover:bg-sunk data-[active=true]:bg-accent-soft">
			<span data-icon-slot class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center text-ink-3 [&>svg]:size-full"></span>
			<div class="min-w-0 flex-1">
				<div data-title class="truncate text-[14px] font-medium text-ink"></div>
				<div data-meta class="mt-0.5 truncate text-[12px] text-ink-3"></div>
			</div>
		</a>
	</template>
</>

<script>
	import Fuse from "fuse.js";
	import type { SearchItem } from "@/lib/search/types";

	// The platform hint is not in TypeScript's lib.dom yet, but Chromium answers
	// it. Tried before the userAgent string, which is the fallback.
	interface NavigatorWithUAData extends Navigator {
		userAgentData?: { platform?: string };
	}

	type ModifierKey = { label: string; key: string };
	type SearchToggleEvent = CustomEvent<{ modifierKey: ModifierKey; open?: boolean }>;

	// Assigned by initOnce() before any user-driven callback can fire, so
	// callsites treat them as non-null.
	let searchDialog!: HTMLDialogElement;
	let searchInput!: HTMLInputElement;

	let fuse: Fuse<SearchItem> | null = null;
	let items: SearchItem[] | undefined = undefined;
	// Dedupes concurrent loads - an idle prefetch overlapping a fast open.
	let loadPromise: Promise<void> | null = null;
	// The keyboard-active row. Reset to 0 on every render, so the arrows move
	// from the top of whatever is now on screen.
	let activeIndex = 0;

	function initOnce() {
		const dialog = document.getElementById("search-dialog");
		if (!dialog) return;

		searchDialog = dialog as HTMLDialogElement;
		searchInput = document.getElementById("search-input") as HTMLInputElement;

		const modifierKey = getModifierKey();
		const activationLetter = searchDialog.dataset.hotkey!;

		document.querySelectorAll("[search-toggle]").forEach((el) =>
			el?.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				fireSearchToggleEvent(true);
			}),
		);

		document.querySelectorAll("[search-toggle-close]").forEach((el) =>
			el?.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				fireSearchToggleEvent(false);
			}),
		);

		document.addEventListener("keydown", (e) => {
			const isCmdOrCtrl = modifierKey.key === "cmd" ? e.metaKey : e.ctrlKey;
			if (isCmdOrCtrl && e.key.toLowerCase() === activationLetter.toLowerCase()) {
				e.preventDefault();
				fireSearchToggleEvent(true);
			}
		});

		// Backdrop click. The dialog fills the viewport, so the backdrop is the
		// dialog itself rather than anything inside the panel.
		document.addEventListener("click", (e) => {
			if ((e.target as HTMLElement) === searchDialog) fireSearchToggleEvent(false);
		});

		document.addEventListener("trigger-search", (e) => {
			const event = e as SearchToggleEvent;
			event.preventDefault();
			event.stopPropagation();

			const { open: shouldOpen } = event.detail;
			if (shouldOpen === undefined) {
				isSearchDialogOpen() ? closeDialog() : openDialog();
				return;
			}
			shouldOpen ? openDialog() : closeDialog();
		});

		// Escape closes a dialog natively, without the reset, which would leave the
		// last query behind for the next open. Taken over so every way out resets.
		searchDialog.addEventListener("keydown", (e) => {
			if (e.key !== "Escape") return;
			e.preventDefault();
			closeDialog();
		});

		searchInput.addEventListener("input", () => renderResults(searchInput.value.trim()));

		// Delegated on the container, so rows rendered later are covered without
		// rebinding. The anchor's own href navigates; this only dismisses.
		document.getElementById("search-results")?.addEventListener("click", (e) => {
			if ((e.target as HTMLElement).closest("[data-search-result]")) closeDialog();
		});

		// Bound to the input rather than the document, since it holds focus for as
		// long as the dialog is open. Tab and Escape keep their default behaviour.
		searchInput.addEventListener("keydown", (e) => {
			if (e.key === "ArrowDown") {
				e.preventDefault();
				moveActive(1);
			} else if (e.key === "ArrowUp") {
				e.preventDefault();
				moveActive(-1);
			} else if (e.key === "Enter") {
				const rows = getResultRows();
				if (rows.length) {
					e.preventDefault();
					rows[activeIndex]?.click();
				}
			}
		});

		if (modifierKey.key !== "cmd") {
			document.querySelectorAll("[data-search-mod-key]").forEach((el) => (el.textContent = modifierKey.label));
		}
		document.querySelectorAll("[data-search-activation-key]").forEach((el) => (el.textContent = activationLetter));

		prefetchIndex();
	}

	initOnce();
	document.addEventListener("astro:after-swap", initOnce);

	// `navigator.platform` is deprecated, so this reads the UA-data hint where
	// there is one and matches the userAgent string otherwise.
	function getModifierKey(): ModifierKey {
		const platform = (navigator as NavigatorWithUAData).userAgentData?.platform ?? "";
		const isApple = platform === "macOS" || /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
		return isApple ? { label: "⌘", key: "cmd" } : { label: "Ctrl", key: "ctrl" };
	}

	function fireSearchToggleEvent(open?: boolean) {
		document.dispatchEvent(new CustomEvent("trigger-search", { detail: { modifierKey: getModifierKey(), open } }));
	}

	function isSearchDialogOpen(): boolean {
		return !!searchDialog?.open;
	}

	// Named around `open` and `close` to keep clear of `window.open` and
	// `window.close`. Renders immediately, so a fresh open shows the empty-state
	// rows rather than the server-rendered message.
	function openDialog() {
		void loadIndex();
		searchDialog.showModal();
		renderResults(searchInput.value.trim());
		setTimeout(() => searchInput.focus(), 50);
	}

	// Clears the input and resets the pane, so re-opening does not flash the
	// previous query's results.
	function closeDialog() {
		searchDialog.close();
		searchInput.value = "";
		renderResults("");
	}

	// Idempotent, and concurrent calls share one in-flight fetch. A failure
	// clears the promise so the next call retries.
	function loadIndex(): Promise<void> {
		if (fuse) return Promise.resolve();
		if (loadPromise) return loadPromise;

		loadPromise = (async () => {
			try {
				if (!items?.length) {
					const url = searchDialog.dataset.indexUrl;
					if (!url) throw new Error("no index url");
					const res = await fetch(url);
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					items = (await res.json()) as SearchItem[];
				}
				fuse = new Fuse(items, {
					keys: [
						{ name: "title", weight: 5 },
						{ name: "description", weight: 3 },
						{ name: "body", weight: 3 },
						{ name: "module", weight: 2 },
						{ name: "page", weight: 2 },
					],
					threshold: 0.5,
					includeScore: true,
					ignoreLocation: true,
					minMatchCharLength: 2,
				});

				// Roll whatever is on screen forward: a typed query from "Searching…"
				// to its results, an empty one from the message to the social rows.
				if (isSearchDialogOpen()) renderResults(searchInput?.value.trim() ?? "");
			} catch (err) {
				console.error("[search] failed to load search index:", err);
				loadPromise = null;
				throw err;
			}
		})();

		return loadPromise;
	}

	// Fetched while the browser is idle, so the index is usually ready by the
	// time the dialog opens.
	function prefetchIndex() {
		const start = () => void loadIndex().catch(() => {});
		if ("requestIdleCallback" in window) {
			(window as Window & { requestIdleCallback: (cb: () => void, opts?: { timeout: number }) => void }).requestIdleCallback(start, { timeout: 2000 });
		} else {
			setTimeout(start, 500);
		}
	}

	// `textContent` keeps any HTML in the message inert, including the query
	// echoed back in "No results for …".
	function setMessage(text: string) {
		const container = document.getElementById("search-results");
		if (!container) return;
		const div = document.createElement("div");
		div.className = "px-4 py-8 text-center text-[13px] text-muted";
		div.textContent = text;
		container.replaceChildren(div);
	}

	// Empty query renders the social rows once the index has loaded, and the
	// configured message before that. Then "Searching…" while the index is still
	// coming, "No results" on a miss, and the rows on a hit.
	function renderResults(query: string) {
		const container = document.getElementById("search-results");
		if (!container) return;

		if (!query) {
			const socials = items?.filter((item) => item.kind === "social") ?? [];
			socials.length ? renderRows(container, socials) : setMessage(searchDialog.dataset.emptyMessage!);
			return;
		}
		if (!fuse) {
			setMessage("Searching…");
			return;
		}

		const results = fuse.search(query, { limit: 20 });
		if (!results.length) {
			setMessage(`No results for "${query}"`);
			return;
		}

		renderRows(
			container,
			results.map((result) => result.item),
		);
	}

	// Rows clone the template and fill their slots by mutation. Icons are already
	// markup, rendered at build, so the slot takes them as they are.
	function renderRows(container: HTMLElement, list: SearchItem[]) {
		const template = document.getElementById("search-result-template") as HTMLTemplateElement | null;
		if (!template) return;

		const fragment = document.createDocumentFragment();
		for (const item of list) {
			const node = template.content.cloneNode(true) as DocumentFragment;
			const link = node.querySelector("[data-search-result]") as HTMLAnchorElement | null;
			const iconSlot = node.querySelector("[data-icon-slot]") as HTMLElement | null;
			const titleEl = node.querySelector("[data-title]") as HTMLElement | null;
			const metaEl = node.querySelector("[data-meta]") as HTMLElement | null;
			if (!link || !iconSlot || !titleEl || !metaEl) continue;

			link.href = item.url;
			// Socials are mailto:, tel: and https:, so they leave the site.
			if (!item.url.startsWith("/") && !item.url.startsWith("#")) {
				link.target = "_blank";
				link.rel = "noopener noreferrer";
			}

			titleEl.textContent = item.title;
			// A section that wraps others is a landing rather than a leaf.
			if (item.isGroup) titleEl.classList.add("italic");

			metaEl.textContent = [item.page, item.module, item.description].filter(Boolean).join(" · ");

			if (item.iconHtml) iconSlot.innerHTML = item.iconHtml;

			fragment.appendChild(node);
		}
		container.replaceChildren(fragment);

		activeIndex = 0;
		applyActive();
	}

	function getResultRows(): HTMLAnchorElement[] {
		return Array.from(document.querySelectorAll<HTMLAnchorElement>("#search-results [data-search-result]"));
	}

	// Wraps at both ends. The `+ length` before the modulo keeps a negative
	// delta in range.
	function moveActive(delta: number) {
		const rows = getResultRows();
		if (!rows.length) return;
		const next = (activeIndex + delta + rows.length) % rows.length;
		if (next === activeIndex) return;
		activeIndex = next;
		applyActive();
		rows[activeIndex]?.scrollIntoView({ block: "nearest" });
	}

	function applyActive() {
		getResultRows().forEach((row, i) => (row.dataset.active = i === activeIndex ? "true" : "false"));
	}
</script>

<style>
	/* A scroll-driven reveal, which is the one thing here a utility cannot express. */
	#search-hint {
		animation: reveal linear both;
		animation-timeline: scroll(root);
		animation-range: 0 200px;
	}
	@keyframes reveal {
		from {
			opacity: 0;
			transform: translateY(50px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
