---
import ModuleWrapper from "@/components/ui/modules/ModuleWrapper.astro";
import BlueprintSectionDisplay from "./BlueprintSectionDisplay.astro";
import { isVisible, loadPart, type AssembledSection } from "@/lib/blueprints";
import { Icon } from "astro-icon/components";

export interface Props {
	section: AssembledSection;
}

const { section } = Astro.props;

const isHidden = section.hidden || !(await isVisible(await loadPart(section.content), Astro.locals.blueprint));
---

<>
	{
		Array.isArray(section.sections) && !!section.sections.length ? (
			<>
				{!isHidden && (
					<ModuleWrapper
						{...{
							...section,
							id: section.id,
							bg: "bg-gray-200 dark:bg-ground-600",
							forceLayout: "stacked",
							header: {
								headerAlign: "center",
								...(section.header ?? {}),
							},
						}}
					>
						{section.icon && <Icon slot="beforeHeader" name={section.icon} class="mb-3 inline-block size-10 leading-4" />}
					</ModuleWrapper>
				)}
				{section.sections.map((f) => (
					<>{!f.hidden && <BlueprintSectionDisplay {...{ section: { ...f, forceLayout: "side" } }} />}</>
				))}
			</>
		) : (
			<>{!isHidden && <BlueprintSectionDisplay {...{ section: { ...section, forceLayout: "side" } }} />}</>
		)
	}
</>
