---
import ModuleWrapper, { type _ModuleHeader, type _ModuleWrapper } from "@/components/ui/modules/ModuleWrapper.astro";
import { Icon } from "astro-icon/components";
import { getCollection, type CollectionEntry } from "astro:content";
import type { Role } from "@/data/roleDefinitions";

export interface Props extends _ModuleWrapper {}

// Read by BlueprintSectionBuild - empty result hides the whole section.
export async function resolve(role: Role | undefined): Promise<CollectionEntry<"skills">[]> {
	const featured = role?.featuredSkills ?? [];
	if (featured.length === 0) return [];
	const all = await getCollection("skills");
	return featured.map((id) => all.find((s) => s.id === id)).filter((s): s is NonNullable<typeof s> => !!s);
}

const props = Astro.props;
const role = Astro.locals.blueprint as Role;

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "Featured Skills",
};

const skills = await resolve(role);
---

<ModuleWrapper {...{ ...props, header }}>
	<div slot="afterHeader" class="mt-3">
		<a
			href="/work#skills"
			class="inline-flex items-center gap-2 rounded-md bg-primary-700 px-2 py-1.5 text-xs font-semibold whitespace-nowrap text-white! hover:bg-black focus:ring-4 focus:ring-primary-300 focus:outline-none print:hidden"
			data-no-print
		>
			<Icon name="ph:brackets-curly" class="size-4" />
			View All
		</a>
	</div>
	<ul class="flex flex-wrap gap-2 text-sm text-gray-600">
		{
			skills.map(({ data }) => (
				<li class="inline-flex items-center gap-1 rounded border border-gray-200 bg-gray-100 px-2 py-1">
					{data.icon && <Icon name={data.icon} class="size-5" />}
					<span>{data.label}</span>
				</li>
			))
		}
	</ul>
</ModuleWrapper>
