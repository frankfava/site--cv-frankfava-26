---
import ModuleWrapper, { type _ModuleHeader, type _ModuleWrapper } from "@/components/ui/modules/ModuleWrapper.astro";
import { Icon } from "astro-icon/components";
import type { Role } from "@/lib/roles";
import { getTransferableSkillsByIds } from "@/lib/collections/transferableSkills";
import CapabilityRadar from "@/components/blueprints/shared/_partials/CapabilityRadar.astro";

export interface Props extends _ModuleWrapper {}

// Read by BlueprintSectionBuild - empty result hides the whole section.
export async function resolve(role: Role | undefined) {
	return getTransferableSkillsByIds(role?.featuredTransferableSkills ?? []);
}

const props = Astro.props;
const role = Astro.locals.blueprint as Role;

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "Transferable Skills",
};

const transferableSkills = await resolve(role);
---

<ModuleWrapper {...{ ...props, header }}>
	<div slot="afterHeader" class="mt-3">
		<a
			href="/how-i-work#transferable-skills"
			class="inline-flex items-center gap-2 rounded-md bg-accent px-2 py-1.5 text-xs font-semibold whitespace-nowrap text-white! hover:bg-accent-800 focus:ring-4 focus:ring-accent focus:outline-none dark:text-ground! dark:hover:bg-accent-300 print:hidden"
			data-no-print
		>
			<Icon name="ph:lightbulb-filament-duotone" class="size-4" />
			View All
		</a>
	</div>
	<div class="grid gap-5 md:grid-cols-3">
		<div class="md:col-span-1">
			<CapabilityRadar class="rounded-md border border-line bg-surface p-3" />
		</div>

		<ul class="grid content-start gap-3 md:col-span-2">
			{
				transferableSkills.map(({ data }) => (
					<li class="flex items-start gap-3 rounded-md border border-line bg-surface p-3">
						{data.icon && <Icon name={data.icon} class="size-6 shrink-0 text-accent" />}
						<div class="grow">
							<div class="leading-tight font-semibold">{data.title}</div>
							{data.summary && <p class="m-0 text-sm text-ink-3">{data.summary}</p>}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</ModuleWrapper>
