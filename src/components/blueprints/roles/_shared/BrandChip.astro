---
import ConditionalLink from "@/components/ui/display/ConditionalLink.astro";
import type { BrandChromeKeyed } from "@/utils/brands";
import { twMerge } from "tailwind-merge";

export interface Props {
	branding: BrandChromeKeyed;
	linkToIndex?: boolean;
	class?: string;
}

const { branding, linkToIndex = false, class: className } = Astro.props;

type LockupPart = { kind: "text"; value: string } | { kind: "logo" } | { kind: "company" };
const TOKEN_RE = /\{\{(logo|company)\}\}/g;

function parseLockup(b: BrandChromeKeyed): LockupPart[] {
	const tpl = b.lockup ?? "Crafted for {{company}}";
	const parts: LockupPart[] = [];
	let last = 0;
	for (const m of tpl.matchAll(TOKEN_RE)) {
		if (m.index! > last) parts.push({ kind: "text", value: tpl.slice(last, m.index) });
		parts.push({ kind: m[1] as "logo" | "company" });
		last = m.index! + m[0].length;
	}
	if (last < tpl.length) parts.push({ kind: "text", value: tpl.slice(last) });
	return parts;
}

const parts = parseLockup(branding);
const brandIndexLink = `/brands/${branding.key}`;
---

<ConditionalLink
	href={linkToIndex ? brandIndexLink : undefined}
	class:list={twMerge(["brand-chip inline-flex items-center gap-2 rounded-full border px-3 py-1 text-sm font-medium", className])}
	style={branding.accent ? `border-color:${branding.accent};color:${branding.accent};` : undefined}
	data-branding-company={branding.company}
>
	{
		parts.map((part) => {
			if (part.kind === "logo" && branding.logo) {
				return <img src={branding.logo} alt={`${branding.company} logo`} class="h-4 w-auto" />;
			}
			if (part.kind === "company") {
				return <span>{branding.company}</span>;
			}
			if (part.kind === "text") {
				return <span>{part.value}</span>;
			}
			return null;
		})
	}
</ConditionalLink>
