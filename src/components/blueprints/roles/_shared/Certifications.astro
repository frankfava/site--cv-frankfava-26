---
import ModuleWrapper, { type _ModuleHeader, type _ModuleWrapper } from "@/components/ui/modules/ModuleWrapper.astro";
import ConditionalLink from "@/components/ui/display/ConditionalLink.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getCollection, type CollectionEntry } from "astro:content";
import type { Role } from "@/data/roleDefinitions";

export interface Props extends _ModuleWrapper {}

// Read by BlueprintSectionBuild - empty result hides the whole section.
export async function resolve(role: Role | undefined): Promise<CollectionEntry<"certifications">[]> {
	const featured = role?.featuredCertifications ?? [];
	if (featured.length === 0) return [];
	const all = await getCollection("certifications");
	return featured.map((id) => all.find((c) => c.id === id)).filter((c): c is NonNullable<typeof c> => !!c);
}

const props = Astro.props;
const role = Astro.locals.blueprint as Role;

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "Certifications",
};

const certifications = await resolve(role);
---

<ModuleWrapper {...{ ...props, header }}>
	<div slot="afterHeader" class="mt-3">
		<a
			href="/credentials#certifications"
			class="inline-flex items-center gap-2 rounded-md bg-primary-700 px-2 py-1.5 text-xs font-semibold whitespace-nowrap text-white! hover:bg-black focus:ring-4 focus:ring-primary-300 focus:outline-none print:hidden"
			data-no-print
		>
			<Icon name="ph:ladder-duotone" class="size-4" />
			View All
		</a>
	</div>
	<ul class="grid gap-3 md:grid-cols-2">
		{
			certifications.map(({ data }) => (
				<li class="flex items-start gap-3 rounded-md border border-gray-200 p-3">
					{data.icon && <Image src={data.icon as string} width={48} height={48} alt={data.issuer} class="size-9 shrink-0 rounded-full" />}
					<div class="grow">
						<div class="leading-tight font-semibold">
							<ConditionalLink href={data.credentialLink}>
								{data.certificate}
								{data.credentialLink && <Icon name="ph:arrow-square-out-duotone" class="ml-1 inline size-4" />}
							</ConditionalLink>
						</div>
						<div class="flex flex-wrap gap-x-2 text-sm text-gray-500">
							<span>{data.issuer}</span>
							{data.ranking && <span>· {data.ranking}</span>}
						</div>
					</div>
				</li>
			))
		}
	</ul>
</ModuleWrapper>
