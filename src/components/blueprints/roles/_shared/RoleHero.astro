---
import { getCurrentPath, getPermalink } from "@/utils/permalinks";
import type { Role } from "@/data/roleDefinitions";
import { Icon } from "astro-icon/components";

// RoleHero only renders inside a role blueprint
const role = Astro.locals.blueprint as Role;

const onePagerPermalink = getPermalink(getCurrentPath(Astro.url) + "/one-pager");
---

<header class="@container/role-hero mb-8 border-b border-gray-200 pb-6">
	<div class="flex flex-col gap-4 @3xl/role-hero:flex-row @3xl/role-hero:items-end @3xl/role-hero:justify-between">
		<h1 class="text-3xl leading-tight font-bold lg:text-5xl">{role.title}</h1>
		<div>
			<a
				href={onePagerPermalink}
				class="inline-flex items-center gap-2 rounded-md bg-primary-700 px-4 py-2 text-sm font-semibold whitespace-nowrap text-white! hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 focus:outline-none print:hidden"
				data-no-print
			>
				<Icon name="ph:file-pdf-duotone" class="size-5" />
				One-Pager
			</a>
		</div>
	</div>
</header>
