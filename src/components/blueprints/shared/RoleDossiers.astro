---
import ModuleWrapper, { type _ModuleWrapper, type _ModuleHeader } from "@/components/ui/modules/ModuleWrapper.astro";
import RoleCards from "./_partials/RoleCards.astro";

export interface Props extends _ModuleWrapper {}

const props = Astro.props;

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "Role pages",
};

const roles = [
	{ slug: "engineering-manager", eyebrow: "Closest match" },
	{ slug: "solutions-architect", eyebrow: "The other half of it" },
	{ slug: "forward-deployed-engineer", eyebrow: "Same job, field org" },
	{ slug: "senior-engineer", eyebrow: "Proven" },
];
---

<ModuleWrapper {...{ ...props, header }}>
	<RoleCards {...{ roles, columnCount: 4, hoverBorder: true, linkText: "Open role page →" }} />
</ModuleWrapper>
