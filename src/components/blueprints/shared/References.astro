---
import ModuleWrapper, { type _ModuleWrapper, type _ModuleHeader } from "@/components/ui/modules/ModuleWrapper.astro";
import { getTestimonials } from "@/lib/collections/testimonials";

export interface Props extends _ModuleWrapper {}

const props = Astro.props;

const testimonials = await getTestimonials();

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "References",
};
---

<ModuleWrapper {...{ ...props, header }}>
	<div class="mx-auto gap-4 md:max-w-200 md:columns-2">
		{
			testimonials.map(({ data: { name, src, width, height } }) => (
				<a class="mb-4 block break-inside-avoid" href={src} target="_blank" rel="noopener" aria-label={`Open the review from ${name} at full size`}>
					<img class="h-auto max-w-full rounded-lg" loading="lazy" src={src} alt={`Testimonial from ${name}`} width={width} height={height} />
				</a>
			))
		}
	</div>
</ModuleWrapper>
