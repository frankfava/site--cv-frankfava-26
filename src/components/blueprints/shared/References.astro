---
import ModuleWrapper, { type _ModuleWrapper, type _ModuleHeader } from "@/components/ui/modules/ModuleWrapper.astro";
import { getTestimonials } from "@/lib/collections/testimonials";

export interface Props extends _ModuleWrapper {}

const props = Astro.props;

const testimonials = await getTestimonials();

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "References",
};
---

<ModuleWrapper {...{ ...props, header }}>
	<p class="text-lg">These are Facebook reviews from customers of my agency, FLIC Sites. Their words, not mine.</p>

	<p><strong>Please note:</strong> this CV is public, so I have not put my references' phone numbers on it. I'm happy to provide them after we've met.</p>

	<div class="mx-auto mt-10 gap-4 md:max-w-200 md:columns-2">
		{
			testimonials.map(({ data: { name, src, width, height } }) => (
				<a class="mb-4 block break-inside-avoid" href={src} target="_blank" rel="noopener" aria-label={`Open the review from ${name} at full size`}>
					<img class="h-auto max-w-full rounded-lg" loading="lazy" src={src} alt={`Testimonial from ${name}`} width={width} height={height} />
				</a>
			))
		}
	</div>

	<p class="mt-8">
		A customer referred me to someone in 2018. When I moved to Sweden, that client wanted to keep me, so they signed on with my new employer to carry on the work, and now that I'm freelancing
		again they are still my client. Eight years, three arrangements, same two people.
	</p>
</ModuleWrapper>
