---
import ModuleWrapper, { type _ModuleWrapper, type _ModuleHeader } from "@/components/ui/modules/ModuleWrapper.astro";
import QuestionCard from "@/components/ui/display/QuestionCard.astro";
import ProjectCard from "@/components/ui/display/ProjectCard.astro";
import { gridColumns } from "@/components/ui/display/Cards.astro";
import { cn } from "@/utils/class";
import { getCollection, getEntry } from "astro:content";

export interface Props extends _ModuleWrapper {}

const props = Astro.props;

/** The system I run, as opposed to the tools I published. It leads the section on its own. */
const frankenverse = await getEntry("projects", "frankenverse-agentic-system");

const tools = (await getCollection("projects", ({ data }) => !data.draft && data.featured && data.tags.includes("ai-tool")))
	.sort((a, b) => (a.data.order ?? Number.POSITIVE_INFINITY) - (b.data.order ?? Number.POSITIVE_INFINITY) || a.data.title.localeCompare(b.data.title))
	.map(({ id, data }) => ({ id, title: data.title, summary: data.summary, type: data.type, startDate: data.startDate, duration: data.duration, demoUrl: data.demoUrl, repoUrl: data.repoUrl }));

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "AI practice",
};
---

<ModuleWrapper {...{ ...props, header }}>
	<div class="space-y-6">
		{
			frankenverse && (
				<div>
					<h3 class="mb-3 text-lg">The system I run</h3>
					<ProjectCard
						{...{
							id: frankenverse.id,
							title: frankenverse.data.title,
							summary: frankenverse.data.summary,
							type: frankenverse.data.type,
							startDate: frankenverse.data.startDate,
							duration: frankenverse.data.duration,
							demoUrl: frankenverse.data.demoUrl,
							repoUrl: frankenverse.data.repoUrl,
							highlights: frankenverse.data.highlights,
							showLink: !!frankenverse.body,
						}}
					/>
				</div>
			)
		}
		<QuestionCard title="How do you actually work with it?" icon="ph:git-branch-duotone" iconClass="text-blue-500">
			<p class="mb-2">
				Claude Code every day, with Cursor alongside it. I use it to argue out a design before any code exists, to document a codebase I have never seen, to stand up an MVP (see the "Create
				MVP" tool below), and to write and refactor the code itself.
			</p>
			<p>What it has not changed is who is accountable for the result. I still have to know whether the answer is right.</p>
		</QuestionCard>
		<QuestionCard title="Will it replace developers?" icon="ph:seal-question-duotone" iconClass="text-blue-500">
			<p class="mb-2">No, but it moves the job. Less of the week goes on writing the code and more of it goes on deciding what should exist and directing the work.</p>
			<p>
				That shift is the part I care about, and it is a people problem before it is a tooling one. Coaching was my first profession, so getting a team to actually take up a new way of working
				is the thing I have most practice at. I do it first myself, then bring people with me.
			</p>
		</QuestionCard>
		<div class="mt-10">
			<h3 class="mb-3 text-lg">Tools I have published</h3>
			<div class={cn("grid grid-cols-1 gap-4", gridColumns(2))}>
				{tools.map((tool) => <ProjectCard {...tool} />)}
			</div>
		</div>
	</div>
</ModuleWrapper>
