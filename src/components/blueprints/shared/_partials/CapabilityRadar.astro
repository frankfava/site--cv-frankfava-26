---
/** The capability radar. `showNeed` adds the role's dashed overlay, which only the interactive check has. */
import { CAPABILITIES } from "@/data/capabilities";
import { radar } from "@/alpine/capability/radar";
import { cn } from "@/utils/class";

export interface Props {
	class?: string;
	eyebrow?: string;
	showNeed?: boolean;
}

const { class: className, eyebrow = "Where I sit", showNeed = false } = Astro.props;
---

<div class={cn(showNeed && "overflow-hidden rounded-lg border border-line bg-surface shadow-(--c-shadow)", className)}>
	{
		showNeed && (
			<div class="flex items-center gap-3 border-b border-line-2 bg-sunk px-4.5 py-3">
				<span class="eyebrow text-ink-3">{eyebrow}</span>
			</div>
		)
	}

	<div class="mx-auto max-w-120 px-2 pt-3.5 pb-0.5">
		<svg class="block h-auto w-full" viewBox={radar.viewBox} role="img" aria-label={showNeed ? "Radar comparing what your role needs against Frank's evidence" : "Radar of Frank's capabilities"}>
			{radar.rings.map((d) => <path d={d} fill="none" stroke="var(--c-line)" stroke-width="1" />)}
			{
				radar.spokes.map((spoke) => (
					<>
						<line x1={radar.cx} y1={radar.cy} x2={spoke.x2} y2={spoke.y2} stroke="var(--c-line)" stroke-width="1" />
						<text x={spoke.labelX} y={spoke.labelY} text-anchor={spoke.anchor} fill="var(--c-ink-3)" font-size="10.5" letter-spacing=".4">
							{spoke.label}
						</text>
					</>
				))
			}
			<path d={radar.mineShape} stroke="var(--c-good)" fill="color-mix(in srgb, var(--c-good) 16%, transparent)" stroke-width="2" stroke-linejoin="round"></path>
			{
				showNeed && (
					<path
						d={radar.yoursShape}
						x-bind:d="yoursShape"
						stroke="var(--c-accent)"
						fill="color-mix(in srgb, var(--c-accent) 12%, transparent)"
						stroke-width="2"
						stroke-linejoin="round"
						stroke-dasharray="5 4"
					/>
				)
			}
		</svg>
	</div>

	{
		showNeed ? (
			<div class="flex flex-wrap gap-4 px-4 pt-0.5 pb-3.5 font-mono text-xs font-medium tracking-wider text-ink-3 uppercase">
				<span class="flex items-center gap-1.5">
					<i class="h-1 w-4 rounded-xs bg-accent" />
					What you need
				</span>
				<span class="flex items-center gap-1.5">
					<i class="h-1 w-4 rounded-xs bg-good" />
					Where I sit
				</span>
			</div>
		) : (
			<dl class="mt-1 grid gap-1 px-1 text-sm">
				{CAPABILITIES.map((cap) => (
					<div class="flex gap-2">
						<dt class="w-24 shrink-0 font-mono text-xs tracking-wider text-ink-3 uppercase">{cap.short}</dt>
						<dd class="m-0 text-ink-2">{cap.label}</dd>
					</div>
				))}
			</dl>
		)
	}
</div>
