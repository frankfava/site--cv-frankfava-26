---
/** Two columns of systems: the ones still running, beside the ones handed over. */

import { systemGroups } from "@/data/systems";
import { cn } from "@/utils/class";

export interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const groups = await systemGroups();
---

<div class={cn("grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-6", className)}>
	{
		groups.map((group) => (
			<div>
				<span class="mb-1.5 block eyebrow text-ink-3">
					{group.systems.length} &middot; {group.countLabel}
				</span>
				<h3 class="mb-1.5 text-lg">{group.title}</h3>
				<p class="mb-3.5 text-sm text-ink-3">{group.why}</p>

				<div class="flex flex-col gap-2">
					{group.systems.map((system) => (
						<article class="grid grid-cols-1 items-center gap-3.5 rounded-md border border-line bg-surface px-4 py-3.5 transition-colors hover:border-accent sm:grid-cols-[minmax(0,1fr)_auto]">
							<div>
								<div class="mb-1.5 flex items-center gap-2">
									<i class={cn("size-1.5 flex-none rounded-full", system.live ? "bg-good" : "bg-ink-3")} />
									<span class="font-mono text-xs tracking-wider text-ink-3 uppercase">{system.status}</span>
								</div>
								<h4 class="mb-1 text-base">{system.title}</h4>
								<p class="text-sm text-ink-2">{system.body}</p>
							</div>

							<div class="text-left whitespace-nowrap sm:text-right">
								<b class="block font-primary text-xl leading-none font-extrabold tracking-tight text-ink" style='font-variation-settings:"wdth" 88'>
									{system.figure}
								</b>
								<small class="font-mono text-xs text-ink-3">{system.figureNote}</small>
							</div>
						</article>
					))}
				</div>
			</div>
		))
	}
</div>
