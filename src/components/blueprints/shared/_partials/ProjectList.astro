---
/** Every project, searchable and filterable by the skills it used. */

import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import ProjectCard from "@/components/ui/display/ProjectCard.astro";
import { Manager as SkillsManager } from "@/lib/collections/skills";
import { cn } from "@/utils/class";

export interface Props {
	title?: string;
	projects?: CollectionEntry<"projects">[];
	skills?: CollectionEntry<"skills">[];
	showCount?: boolean;
	showSearchBar?: boolean;
	showLinks?: boolean;
	class?: HTMLAttributes<"div">["class:list"];
}

const {
	title = "Projects",
	projects: allProjects = await getCollection("projects"),
	skills: allSkills = await getCollection("skills"),
	showLinks = true,
	showCount = true,
	showSearchBar = true,
	class: className,
} = Astro.props;

type Project = {
	id: CollectionEntry<"projects">["id"];
	showLink: boolean;
	skills: ({ id: CollectionEntry<"skills">["id"] } & Pick<CollectionEntry<"skills">["data"], "label" | "icon">)[];
} & Omit<CollectionEntry<"projects">["data"], "skills">;

const projects: Project[] = allProjects
	.filter(({ data }) => !data.draft && data.listed)
	.map((project) => {
		const skills = SkillsManager.sortSkills(allSkills)
			.filter((skill) => (project.data.skills ?? []).map((s) => s.id).includes(skill.id))
			.map(({ id, data }) => ({ id, label: data.label, icon: data.icon }));
		return { id: project.id, showLink: showLinks && !!project.body, ...project.data, skills } as Project;
	})
	// Featured first, then explicit order, then alphabetical.
	.sort((a, b) => {
		if (a.featured !== b.featured) return a.featured ? -1 : 1;
		const order = (a.order ?? Number.POSITIVE_INFINITY) - (b.order ?? Number.POSITIVE_INFINITY);
		return order !== 0 ? order : a.title.localeCompare(b.title);
	});

const skills = new SkillsManager(allSkills).sort("proficiency", true)._restructure();

/** Only what the filtering needs: the rows themselves are already in the markup. */
const projectData = projects.map(({ id, title: name, summary, highlights, skills: used }) => ({
	id,
	title: name,
	summary,
	highlights: highlights ?? [],
	skills: used.map(({ id: skillId, label }) => ({ id: skillId, label })),
}));
const skillData = skills.map(({ id, label }) => ({ id, label }));
---

<div
	x-data="projectList"
	data-projects={JSON.stringify(projectData)}
	data-skills={JSON.stringify(skillData)}
	class={cn("grid gap-5", className)}
	x-bind:class="fullscreenClass"
	@keydown.escape.window="handleEscape"
>
	<div x-show="isFullscreen" class="flex items-center justify-between border-b border-line pb-4" style="display: none">
		<div class="text-2xl font-bold">{title}</div>
		<button type="button" @click="closeFullscreen" class="cursor-pointer rounded-md border border-line p-1 text-base text-ink-2 transition-colors hover:bg-sunk hover:text-ink">
			<Icon name="ph:arrows-in-simple" class="size-5" />
			<span class="sr-only">Exit fullscreen</span>
		</button>
	</div>

	<div class="flex flex-col items-center gap-2 xl:flex-row xl:gap-6">
		<div class="flex w-full items-center gap-2 text-xl xl:w-1/4">
			<button type="button" @click="clearFilters" x-show="isFiltered" style="display: none" class="h-auto rounded-md bg-bad px-3 text-base text-white transition-colors hover:opacity-90">
				Clear
			</button>
			{
				showCount && (
					<>
						<span x-text="totalProjectsLabel" />
						<span class="text-sm" x-show="isFiltered" style="display: none" x-text="filteredProjectsLabel" />
					</>
				)
			}
			<button
				type="button"
				x-show="!isFullscreen"
				@click="openFullscreen"
				x-bind:aria-label="fullscreenLabel"
				class="ml-auto cursor-pointer rounded-md p-2 text-ink-3 transition-colors hover:bg-sunk hover:text-ink print:hidden"
			>
				<Icon name="ph:arrows-out-simple" class="size-5" />
			</button>
		</div>

		{
			showSearchBar && (
				<div class="w-full xl:w-3/4">
					<input
						type="search"
						x-model="searchQuery"
						placeholder="Search projects…"
						class="mt-2 block w-full rounded-md border border-line bg-surface px-3 py-2 text-ink placeholder-ink-3 focus:border-ink-3 focus:ring-3 focus:ring-line focus:outline-none"
					/>
				</div>
			)
		}
	</div>

	<div class="flex flex-col gap-6 xl:flex-row">
		<div class="w-full xl:w-1/4 xl:border-r xl:border-line xl:pr-6">
			<div class="grid gap-4 xl:sticky" x-bind:class="stickyClass">
				<div class="rounded-md border border-line bg-surface p-4 shadow-md">
					<div class="mb-2 text-lg">
						<span class="font-bold">Filter by skill</span>
						<span x-show="hasSkillFilters" style="display: none" class="ml-1" x-text="skillsCountLabel"></span>
					</div>

					<div class="mb-3">
						<input
							type="search"
							x-model="skillQuery"
							placeholder="Search skills…"
							class="block w-full rounded-md border border-line bg-surface px-3 py-1 text-ink placeholder-ink-3 focus:border-ink-3 focus:ring-3 focus:ring-line focus:outline-none"
						/>
					</div>

					<div class="max-h-[350px] space-y-1 overflow-y-auto px-1">
						{
							skills.map(({ id, label }) => (
								<label x-data="projectSkill" data-id={id} data-label={label} x-show="shown" class="flex cursor-pointer items-center">
									<input type="checkbox" class="mr-2" @change="toggle" x-bind:checked="active" />
									<span>{label}</span>
								</label>
							))
						}
					</div>
				</div>
			</div>
		</div>

		<div id="project-display" class="w-full xl:w-3/4">
			<div class="grid auto-rows-min gap-3">
				{
					projects.map(({ id, title: name, type, showLink, summary, demoUrl, repoUrl, startDate, duration, skills: used, highlights }) => (
						<ProjectCard
							{...{ id, title: name, summary, type, startDate, duration, demoUrl, repoUrl, highlights, showLink, skills: used }}
							x-data="projectRow"
							data-id={id}
							x-show="shown"
							skill={(entry) => (
								<li
									x-data="projectSkill"
									data-id={entry.id}
									data-label={entry.label}
									{...{ "@click": "toggle", "x-bind:class": "chipClass" }}
									class="inline-flex cursor-pointer items-center gap-1 rounded border px-2 py-1"
								>
									<Icon name={entry.icon} class="size-5" />
									<span>{entry.label}</span>
								</li>
							)}
						/>
					))
				}
			</div>
		</div>
	</div>
</div>
