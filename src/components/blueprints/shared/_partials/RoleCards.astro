---
/** Registry roles as cards, each linking to its role page. */
import Cards, { type Props as CardsProps } from "@/components/ui/display/Cards.astro";
import { getRole, onlyVisibleRoles, roleIsVisible, ROLES } from "@/lib/roles";
import type { _Card } from "@/types";

export interface Props extends Omit<CardsProps, "cards"> {
	roles?: { slug: string; eyebrow?: string }[];
}

const { roles = onlyVisibleRoles(ROLES), ...cardProps }: Props = Astro.props;

/** Visibility stays the registry's call, so a named role that is off still drops out. */
const cards = roles.flatMap<_Card>(({ slug, eyebrow }) => {
	const role = getRole(slug);
	if (!role || !roleIsVisible(role)) return [];
	return { key: role.slug, eyebrow, title: role.title, body: role.summary, link: { href: `/roles/${role.slug}` } };
});
---

<Cards {...cardProps} {cards} />
