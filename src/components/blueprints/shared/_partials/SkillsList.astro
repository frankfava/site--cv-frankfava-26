---
/** Every technical skill, searchable and filterable by relevance, proficiency and keyword. */

import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import ModalWrapper from "@/components/ui/display/ModalWrapper.astro";
import { getSkills, Manager as SkillsManager, type Skills } from "@/lib/collections/skills";
import { cn } from "@/utils/class";

export interface Props {
	title?: string;
	skills?: Skills.Collection;
	filters?: ("proficiency" | "cv" | "keywords" | "relevance")[];
	filterToggles?: { proficiency?: boolean; keywords?: boolean; cv?: boolean; relevance?: boolean };
	allowFullscreen?: boolean;
	class?: HTMLAttributes<"div">["class:list"];
}

const {
	title = "Skills",
	skills: list = await getSkills(),
	filters = ["relevance", "proficiency", "cv", "keywords"],
	filterToggles = { relevance: true, proficiency: true, cv: false, keywords: true },
	allowFullscreen = false,
	class: className,
} = Astro.props;

// Relevance is the outer axis, then featured, then proficiency.
const skills = new SkillsManager(list).sort("proficiency", true).sort("featured", false).sort("relevance", true)._restructure();

const relevanceOptions = SkillsManager.getRelevanceOptions();
const usedProficiencies = new Set(skills.map(({ proficiency }) => proficiency.key));
const proficiencyOptions = SkillsManager.getProficiencies().filter(({ key }) => usedProficiencies.has(key));
const keywordOptions = [...new Set(skills.flatMap(({ keywords }) => keywords))].sort((a, b) => a.localeCompare(b));

const skillData = skills.map(({ id, label, keywords, proficiency, relevance, usedForCv }) => ({ id, label, keywords, proficiency, relevance, usedForCv }));

const panels = [
	{ key: "relevance", label: "Filter by relevance" },
	{ key: "proficiency", label: "Filter by proficiency" },
	{ key: "keywords", label: "Filter by keywords" },
] as const;
---

<div
	x-data="skillList"
	data-skills={JSON.stringify(skillData)}
	data-proficiencies={JSON.stringify(proficiencyOptions)}
	data-relevance={JSON.stringify(relevanceOptions)}
	data-filters={JSON.stringify(filters)}
	data-toggles={JSON.stringify(filterToggles)}
	class={cn("grid gap-6", className)}
	x-bind:class="fullscreenClass"
	@keydown.escape.window="handleEscape"
>
	<div x-show="isFullscreen" style="display: none" class="flex items-center justify-between border-b border-line pb-4">
		<div class="text-2xl font-bold">{title}</div>
		<button type="button" @click="closeFullscreen" class="cursor-pointer rounded-md border border-line p-1 text-base text-ink-2 transition-colors hover:bg-sunk hover:text-ink">
			<Icon name="ph:arrows-in-simple" class="size-5" />
			<span class="sr-only">Exit fullscreen</span>
		</button>
	</div>

	<div class="flex flex-col items-center gap-2 xl:flex-row xl:gap-6">
		<div class="flex w-full items-center gap-2 text-xl xl:w-1/4">
			<button
				type="button"
				@click="clearFilters"
				x-show="isFiltered"
				style="display: none"
				class="h-auto rounded-md bg-bad px-3 text-base text-white transition-colors hover:opacity-90 dark:text-ground"
			>
				Clear
			</button>
			<span x-text="totalSkillsLabel"></span>
			<span class="text-sm" x-text="filteredSkillsLabel"></span>

			<button
				type="button"
				@click="toggleMobileFilters"
				x-bind:aria-expanded="mobileFiltersOpen"
				class="ml-auto flex items-center gap-2 rounded-md bg-accent px-3 py-1.5 text-sm font-semibold text-white xl:hidden dark:text-ground print:hidden"
			>
				<Icon name="ph:funnel-duotone" class="size-4" />
				<span x-text="mobileFiltersLabel"></span>
				<span x-show="isFiltered" style="display: none" class="rounded bg-white px-1.5 text-xs font-bold text-accent dark:bg-ground">!</span>
			</button>

			{
				allowFullscreen && (
					<button
						type="button"
						x-show="!isFullscreen"
						@click="openFullscreen"
						x-bind:aria-label="fullscreenLabel"
						class="cursor-pointer rounded-md p-2 text-ink-3 transition-colors hover:bg-sunk hover:text-ink xl:ml-auto print:hidden"
					>
						<Icon name="ph:arrows-out-simple" class="size-5" />
					</button>
				)
			}
		</div>

		<div class="w-full xl:w-3/4 xl:pr-5">
			<input
				type="search"
				x-model="searchQuery"
				placeholder="Search skills…"
				class="mt-2 block w-full rounded-md border border-line bg-surface px-3 py-2 text-ink placeholder-ink-3 focus:border-ink-3 focus:ring-3 focus:ring-line focus:outline-none"
			/>
		</div>
	</div>

	<div class="flex flex-col gap-6 xl:flex-row">
		<div class="w-full xl:w-1/4 xl:border-r xl:border-line xl:pr-6" x-bind:class="panelsClass">
			<div class="grid gap-4 xl:sticky" x-bind:class="stickyClass">
				{
					panels
						.filter(({ key }) => filters.includes(key))
						.map(({ key, label }) => (
							<div x-data="skillPanel" data-panel={key} class="rounded-md border border-line bg-surface p-4 shadow-md">
								<button
									type="button"
									@click="toggle"
									x-bind:aria-expanded="expanded"
									aria-controls={`skills-filter--${key}`}
									class="flex w-full items-center justify-between gap-3 text-left text-ink"
								>
									<div class="flex items-center gap-2 text-lg">
										<span>
											<span class="font-bold">{label}</span>
											<span x-show="hasCount" style="display: none" class="ml-1" x-text="countLabel" />
										</span>

										{key === "relevance" && (
											<ModalWrapper modalTitle="Skill relevance">
												<Icon slot="button" name="ph:question-duotone" class="size-5 cursor-pointer" />
												<div class="space-y-6">
													{relevanceOptions.map(({ label: name, description }) => (
														<div class="text-ink-2">
															<div class="mb-1 text-lg font-semibold">{name}</div>
															<div>{description}</div>
														</div>
													))}
												</div>
											</ModalWrapper>
										)}

										{key === "proficiency" && (
											<ModalWrapper modalTitle="Proficiencies">
												<Icon slot="button" name="ph:question-duotone" class="size-5 cursor-pointer" />
												<div class="space-y-6">
													{proficiencyOptions.map(({ label: name, description }) => (
														<div class="text-ink-2">
															<div class="mb-1 text-lg font-semibold capitalize">{name}</div>
															<div>{description}</div>
														</div>
													))}
												</div>
											</ModalWrapper>
										)}
									</div>
									<Icon name="ph:caret-up-bold" class="size-5 shrink-0 transition" x-bind:class="caretClass" />
								</button>

								<div x-show="open" id={`skills-filter--${key}`} role="region" class="mt-3 max-h-45 space-y-1 overflow-y-auto px-1">
									{key === "relevance" &&
										relevanceOptions.map(({ key: value, label: name }) => (
											<label x-data="skillFacet" data-facet="relevance" data-value={value} class="flex cursor-pointer items-center">
												<input type="checkbox" class="mr-2" @change="toggle" x-bind:checked="active" />
												<span>
													{name}
													<span class="ml-1 text-ink-3" x-text="countLabel" />
												</span>
											</label>
										))}

									{key === "proficiency" &&
										proficiencyOptions.map(({ key: value, label: name }) => (
											<label x-data="skillFacet" data-facet="proficiency" data-value={value} class="flex cursor-pointer items-center">
												<input type="checkbox" class="mr-2" @change="toggle" x-bind:checked="active" />
												<span class="capitalize">{name}</span>
											</label>
										))}

									{key === "keywords" &&
										keywordOptions.map((keyword) => (
											<label x-data="skillFacet" data-facet="keywords" data-value={keyword} class="flex cursor-pointer items-center">
												<input type="checkbox" class="mr-2" @change="toggle" x-bind:checked="active" />
												<span>{keyword}</span>
											</label>
										))}
								</div>
							</div>
						))
				}

				{
					filters.includes("cv") && (
						<div x-data="skillPanel" data-panel="cv" x-show="showCvFilter" style="display: none" class="rounded-md border border-line bg-surface p-4 shadow-md">
							<button
								type="button"
								@click="toggle"
								x-bind:aria-expanded="expanded"
								aria-controls="skills-filter--cv"
								class="flex w-full items-center justify-between gap-3 text-left text-ink"
							>
								<div class="flex items-center gap-2 text-lg">
									<span class="font-bold">Used for this CV</span>
								</div>
								<Icon name="ph:caret-up-bold" class="size-5 shrink-0 transition" x-bind:class="caretClass" />
							</button>
							<div x-show="open" id="skills-filter--cv" role="region" class="mt-3 px-1">
								<label class="inline-flex cursor-pointer flex-wrap items-center gap-2">
									<input type="checkbox" class="mr-2" @change="toggleCv" x-bind:checked="onlyForThisCV" />
									<span class="text-sm font-semibold text-ink">Only show skills used for this CV</span>
								</label>
							</div>
						</div>
					)
				}
			</div>
		</div>

		<div id="skill-display" class="@container/skills w-full xl:w-3/4" x-bind:class="scrollClass">
			<div class="grid auto-rows-min gap-3 lg:grid-cols-2 lg:pr-4 lg:pb-6 @min-[1475px]/skills:grid-cols-3">
				{
					skills.map(({ id, label, icon, proficiency, yrsExperience, relevance: tags, note, keywords, usedForCv }) => (
						<div x-data="skillCard" data-id={id} x-show="shown" class="rounded-md border border-line bg-surface p-4 shadow-md lg:p-6">
							<div class="grid gap-2">
								<div class="flex w-full flex-wrap items-center gap-3">
									{icon && (
										<div class="flex size-12 items-center justify-center rounded-md border border-line bg-sunk">
											<Icon name={icon} class="size-7" />
										</div>
									)}
									<div class="grow">
										<h3 class="text-lg font-semibold text-ink">{label}</h3>
										{yrsExperience && (
											<div class="text-sm text-ink-3">
												{yrsExperience} year{yrsExperience === 1 ? "" : "s"} experience
											</div>
										)}
									</div>
									{proficiency && (
										<span
											x-data="skillFacet"
											data-facet="proficiency"
											data-value={proficiency.key}
											@click="toggle"
											class="cursor-pointer rounded-full border border-line bg-sunk px-3 py-1 text-xs font-semibold text-ink-2 capitalize"
										>
											{proficiency.label}
										</span>
									)}
								</div>

								{(!!keywords.length || !!tags.length || usedForCv) && (
									<ul class="mt-2 flex flex-wrap gap-2 text-sm">
										{tags.map(({ key, label: name }) => (
											<li
												x-data="skillFacet"
												data-facet="relevance"
												data-value={key}
												@click="toggle"
												x-bind:class="tagClass"
												class="inline-block cursor-pointer rounded-xl border px-3 py-0.5"
											>
												{name}
											</li>
										))}
										{keywords.map((keyword) => (
											<li
												x-data="skillFacet"
												data-facet="keywords"
												data-value={keyword}
												@click="toggle"
												x-bind:class="tagClass"
												class="inline-block cursor-pointer rounded-xl border px-3 py-0.5"
											>
												{keyword}
											</li>
										))}
										{usedForCv && <li class="inline-block rounded-xl border border-amber bg-amber/10 px-3 py-0.5 text-amber">Used for this CV</li>}
									</ul>
								)}

								{note && (
									<div class="mt-3 border-t border-line pt-3">
										<div class="text-sm text-ink-3">{note}</div>
									</div>
								)}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</div>
