---
/** Four series across the whole career, scrubbable, with a read-out for the year under the cursor. */

import { CAREER_SERIES } from "@/data/career";
import { openingIndex, yearAverage } from "@/lib/career";
import { getCareerYears } from "@/lib/collections/career";
import { CHART, chartX, chartY } from "@/alpine/career/chart";
import CareerDoughnut, { type Props as DoughnutProps } from "./CareerDoughnut.astro";
import { cn } from "@/utils/class";

export interface Props {
	/** How the selected year's four numbers read: as bars, or as a ring with their average. */
	readout?: "bars" | "rings" | "segments";
	/** Passed straight through when `readout` is a ring. */
	doughnut?: Omit<DoughnutProps, "variant">;
	/** The four series averaged, drawn across the whole timeline. Off unless asked for. */
	trend?: boolean;
	/** What that averaged line is called in the legend. */
	trendLabel?: string;
	class?: string;
}

const { readout = "bars", doughnut, trend = false, trendLabel = "Match", class: className } = Astro.props;

/** Only a ring with its key beside it needs the wider track. Both spelled out so Tailwind sees them. */
const wideReadout = readout !== "bars" && doughnut?.showKey !== false;
const readoutColumns = wideReadout ? "md:grid-cols-[minmax(0,1fr)_340px]" : "md:grid-cols-[minmax(0,1fr)_244px]";

const years = await getCareerYears();
const openingAt = openingIndex(years);
const opening = years[openingAt];
const first = years[0].year;
const last = years[years.length - 1].year;
const count = years.length;

const gridlines = [0, 25, 50, 75, 100].map((value) => ({ value, y: chartY(value) }));

const shapes = CAREER_SERIES.map((series) => {
	const line = years.map((year, i) => `${i ? "L" : "M"}${chartX(i, count).toFixed(1)} ${chartY(year.axes[series.key]).toFixed(1)}`).join(" ");
	return {
		...series,
		line,
		area: `${line} L ${chartX(count - 1, count)} ${chartY(0)} L ${chartX(0, count)} ${chartY(0)} Z`,
		fill: `color-mix(in srgb, ${series.color} 13%, transparent)`,
	};
});

/** Derived rather than measured, so it is drawn apart from the four series. */
const trendLine = years.map((year, i) => `${i ? "L" : "M"}${chartX(i, count).toFixed(1)} ${chartY(yearAverage(CAREER_SERIES, year)).toFixed(1)}`).join(" ");

/** Every third year, plus the last. Which survive at a given width is decided on the client. */
const yearLabels = years.map((year, i) => ({ ...year, i })).filter((year) => year.year % 3 === 0 || year.i === count - 1);
---

<div class={cn("overflow-hidden rounded-lg border border-line bg-surface shadow-(--c-shadow)", className)} x-data="careerTimeline" data-years={JSON.stringify(years)}>
	<div class="flex items-center gap-3 border-b border-line-2 bg-sunk px-4.5 py-3">
		<span class="eyebrow text-ink-3">{first} &ndash; {last} &middot; drag to read a year</span>
	</div>

	<div class="relative px-4.5 pt-4 pb-1.5">
		<svg
			class="block h-auto w-full touch-none"
			x-ref="chart"
			viewBox={`0 0 ${CHART.W} ${CHART.H}`}
			role="img"
			aria-label={`Four series across ${first} to ${last}`}
			x-on:pointermove="scrub"
			x-on:pointerdown="scrub"
		>
			{
				gridlines.map((gridline) => (
					<>
						<line x1={CHART.LEFT} x2={CHART.W - CHART.RIGHT} y1={gridline.y} y2={gridline.y} stroke="var(--c-line-2)" stroke-width="1" />
						<text x={CHART.LEFT - 9} y={gridline.y} text-anchor="end" dominant-baseline="middle" fill="var(--c-ink-3)" font-size="11" x-show="showAxisValues" x-bind:font-size="labelSize">
							{gridline.value}
						</text>
					</>
				))
			}

			{
				shapes.map((shape) => (
					<>
						<path d={shape.area} fill={shape.fill} stroke="none" />
						<path d={shape.line} fill="none" stroke={shape.color} stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" />
					</>
				))
			}

			{trend && <path d={trendLine} fill="none" stroke="var(--c-ink-3)" stroke-width="1.25" stroke-dasharray="6 5" stroke-linejoin="round" stroke-linecap="round" />}

			{
				yearLabels.map((label, n) => (
					<text
						x={chartX(label.i, count)}
						y={CHART.H - 11}
						text-anchor="middle"
						fill="var(--c-ink-3)"
						font-size="11"
						x-data="careerYearLabel"
						data-index={label.i}
						data-previous={n === 0 ? -1 : yearLabels[n - 1].i}
						x-show="show"
						x-bind:font-size="size"
					>
						{label.year}
					</text>
				))
			}

			<line
				x1={chartX(openingAt, count)}
				x2={chartX(openingAt, count)}
				y1={CHART.TOP}
				y2={CHART.H - CHART.BOTTOM}
				stroke="var(--c-ink-2)"
				stroke-width="1"
				stroke-opacity=".5"
				x-bind:x1="cursorX"
				x-bind:x2="cursorX"></line>

			{
				CAREER_SERIES.map((series) => (
					<circle
						r="4.5"
						cx={chartX(openingAt, count)}
						cy={chartY(opening.axes[series.key])}
						fill={series.color}
						stroke="var(--c-surface)"
						stroke-width="2"
						x-data="careerDot"
						data-series={series.key}
						x-bind:cx="cx"
						x-bind:cy="cy"
					/>
				))
			}
		</svg>

		<label class="sr-only" for="career-year">Year</label>
		<input class="mt-1 block w-full accent-accent" id="career-year" type="range" min="0" max={count - 1} value={openingAt} step="1" x-bind:value="index" x-on:input="setIndex" />
	</div>

	<div class="flex flex-wrap gap-4.5 px-4.5 pt-1.5 pb-3">
		{
			CAREER_SERIES.map((series) => (
				<span class="flex items-center gap-1.5 font-mono text-xs font-medium tracking-wider text-ink-3 uppercase">
					<i class="h-2 w-3.5 flex-none rounded-xs" style={`background:${series.color}`} />
					{series.label}
				</span>
			))
		}

		{
			trend && (
				<span class="flex items-center gap-1.5 font-mono text-xs font-medium tracking-wider text-ink-3 uppercase">
					<i class="h-0 w-3.5 flex-none border-t border-dashed border-ink-3" />
					{trendLabel}
				</span>
			)
		}
	</div>

	<div class:list={["grid grid-cols-1 gap-3.5 border-t border-line-2 p-4.5 md:gap-5.5", readoutColumns]}>
		<div>
			<div class="font-mono text-xs tracking-wider text-accent tab" x-text="year.year">{opening.year}</div>
			<h4 class="mt-1.5 mb-0.5 text-lg" x-text="year.role">{opening.role}</h4>
			<div class="mb-2.5 text-sm text-ink-3" x-text="year.company">{opening.company}</div>
			<p class="text-sm text-ink-2" x-text="year.note">{opening.note}</p>
		</div>

		{
			readout === "bars" ? (
				<div class="flex flex-col gap-2.5">
					{CAREER_SERIES.map((series) => (
						<div>
							<div class="mb-1.5 flex justify-between gap-2.5 font-mono text-xs font-medium tracking-wider text-ink-3 uppercase">
								<span>{series.label}</span>
								<b class="font-medium text-ink tab" x-text={`year.axes.${series.key}`}>
									{opening.axes[series.key]}
								</b>
							</div>
							<div class="h-1.5 overflow-hidden rounded-full bg-sunk">
								<i
									class="block h-full rounded-full transition-[width] duration-350 ease-[cubic-bezier(0.2,0.8,0.2,1)]"
									style={`background:${series.color};width:${opening.axes[series.key]}%`}
									x-data="careerBar"
									data-series={series.key}
									x-bind:style="style"
								/>
							</div>
						</div>
					))}
				</div>
			) : (
				<CareerDoughnut variant={readout} {...doughnut} />
			)
		}
	</div>
</div>
