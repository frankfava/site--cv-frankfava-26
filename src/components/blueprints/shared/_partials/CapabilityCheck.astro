---
/** The capability check: the sliders, and the radar they redraw. */
import { CAPABILITIES } from "@/data/capabilities";
import CapabilityRadar from "./CapabilityRadar.astro";
import { cn } from "@/utils/class";
import FitDial from "@/components/shared/sidebar/FitDial.astro";

export interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("text-left", className)} x-data="capabilityPanel">
	<div class="grid grid-cols-1 items-start gap-3.5 lg:grid-cols-[minmax(0,1fr)_minmax(0,352px)]">
		<div class="order-2 overflow-hidden lg:order-1">
			<div class="flex flex-col gap-3.5 rounded-lg border border-line bg-surface shadow-(--c-shadow)">
				<div class="items-center gap-3 border-b border-line-2 bg-sunk px-4.5 py-3 lg:flex">
					<span class="eyebrow text-ink-3">What your role needs</span>
					<div class="flex flex-wrap gap-2 lg:ml-auto">
						<button
							type="button"
							class="cursor-pointer rounded border border-line px-2.5 py-1.5 font-mono text-xs tracking-wider text-ink-2 uppercase transition-colors hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-accent"
							aria-pressed="false"
							x-bind:aria-pressed="unison"
							x-on:click="toggleUnison">Move together</button
						>
						<button
							type="button"
							class="cursor-pointer rounded border border-line px-2.5 py-1.5 font-mono text-xs tracking-wider text-ink-2 uppercase hover:border-accent hover:text-accent"
							x-on:click="reset">Reset</button
						>
					</div>
				</div>
				<div class="px-4.5 pt-1 pb-4">
					{
						CAPABILITIES.map((cap) => (
							<div class="border-b border-line-2 py-3.5 last:border-b-0" x-data="capabilityRow" data-capability={cap.id}>
								<div class="mb-0.5 flex items-baseline gap-3">
									<label class="text-base font-semibold" for={`need-${cap.id}`}>
										{cap.label}
									</label>
									<span class="ml-auto font-mono text-xs whitespace-nowrap text-ink-3">
										need{" "}
										<b class="font-medium text-ink tab" x-text="need">
											{cap.defaultNeed}
										</b>
									</span>
								</div>
								<p class="mb-2.5 text-sm text-ink-3">{cap.evidence}</p>
								<input
									class="m-0 block w-full accent-accent"
									type="range"
									id={`need-${cap.id}`}
									min="0"
									max="100"
									step="5"
									value={cap.defaultNeed}
									x-bind:value="need"
									x-on:input="setNeed"
								/>
								<div class="mt-2 flex items-center gap-2 text-sm text-ink-3 [&.is-covered]:text-good [&.is-gap]:text-bad [&.is-tight]:text-warn" x-bind:class="verdictClass">
									<i class="size-2 flex-none rounded-full bg-current" />
									<span x-text="verdictText">Covered, with room to spare.</span>
								</div>
							</div>
						))
					}
				</div>
			</div>
			<FitDial class="mt-3 block lg:hidden" showNoteLead={false} showNoteBody={false} />
		</div>

		<CapabilityRadar class="order-1 lg:order-2" eyebrow="Your role vs me" showNeed />
	</div>
</div>
