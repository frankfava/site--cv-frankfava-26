---
import ModuleWrapper, { type _ModuleWrapper, type _ModuleHeader } from "@/components/ui/modules/ModuleWrapper.astro";
import { Icon } from "astro-icon/components";

export interface Props extends _ModuleWrapper {}

const props = Astro.props;

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "Personality tests",
};

const CRYSTAL = "https://www.crystalknows.com/p/6729bd52-0db8-4401-8dfe-d48702818b3f";
const PERSONALITY_MAX = "https://personalitymax.com/report/?pt=68-32-63-68&mi=57-83-60-80-20-73-87-73&ls=74-38-79&bh=55&name_key=d124266ec2";

/** Each reading, with the place it came from. The link is the evidence, not the headline. */
const readings = [
	{ label: "MBTI", value: "ENTJ", note: "the Visionary, or the Chief", href: "https://hubspot.crystalknows.com/personality-type/entj/strengths" },
	{ label: "DISC", value: "D", note: "the Captain", href: "https://www.crystalknows.com/disc/d-personality-type" },
	{ label: "Enneagram", value: "Type 3", note: "the Performer", href: "https://www.crystalknows.com/enneagram/type-3" },
	{ label: "Intelligences", value: "Intrapersonal, logical", note: "the top two of eight", href: `${PERSONALITY_MAX}#your-multiple-intelligences` },
	{ label: "Learning style", value: "Kinesthetic", note: "I learn by doing it", href: `${PERSONALITY_MAX}#your-learning-styles` },
	{ label: "Brain hemispheres", value: "55 / 45", note: "logical against abstract", href: `${PERSONALITY_MAX}#your-brain-hemispheres` },
];

const reports = [
	{ name: "Crystal Knows", href: CRYSTAL },
	{ name: "Personality Max", href: PERSONALITY_MAX },
];
---

<ModuleWrapper {...{ ...props, header }}>
	<div class="space-y-4">
		<div id="how-to-get-best-from-me" class="mt-6 scroll-mt-[150px] rounded border border-line bg-sunk p-5">
			<h3 class="mb-3 text-lg">How you get the best from me</h3>
			<ul class="ml-6 list-outside list-disc space-y-2">
				<li>Give me the goal and let me run at it. I need something to aim for.</li>
				<li>Put me on a team, so I can help the people around me hit theirs.</li>
				<li>Be direct with me. I would rather hear it than work it out.</li>
				<li>Say when something lands. I keep score, and I would rather do it honestly.</li>
			</ul>
		</div>
		<div class="mt-8 space-y-4">
			<h3 class="mb-2 text-lg">What the tests say</h3>
			<dl class="grid gap-2 sm:grid-cols-2">
				{
					readings.map(({ label, value, note, href }) => (
						<div class="rounded-md border border-line bg-surface px-4 py-3">
							<dt class="font-mono text-xs tracking-wider text-ink-3 uppercase">{label}</dt>
							<dd class="m-0">
								<a href={href} target="_blank" rel="noopener" class="font-semibold">
									{value}
								</a>
								<span class="text-ink-3"> · {note}</span>
							</dd>
						</div>
					))
				}
			</dl>
		</div>
		<p class="text-sm text-ink-3">
			Full reports:{" "}
			{
				reports.map(({ name, href }, index) => (
					<>
						{index > 0 && <span> · </span>}
						<a href={href} target="_blank" rel="noopener">
							{name}
							<Icon name="ph:arrow-square-out-duotone" class="ml-1 inline-block size-4 align-text-bottom" />
						</a>
					</>
				))
			}
		</p>
	</div>
</ModuleWrapper>
