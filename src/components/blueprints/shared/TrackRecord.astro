---
import ModuleWrapper, { type _ModuleWrapper, type _ModuleHeader } from "@/components/ui/modules/ModuleWrapper.astro";
import Callout from "@/components/ui/display/Callout.astro";
import CareerTimeline from "./_partials/CareerTimeline.astro";

export interface Props extends _ModuleWrapper {}

const props = Astro.props;

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "Track record",
};
---

<ModuleWrapper {...{ forceLayout: "stacked", ...props, header }}>
	<span slot="beforeHeader" class="mb-2 block eyebrow text-accent">Track record</span>
	<Callout title="How to read this" class="mt-0">
		Four things vary independently across a career: how much of the deciding was mine, how close I sat to the customer, how much of my week went on writing code, and how far I was accountable for
		other people. Drag across the chart, or use the slider, to read any year.
	</Callout>

	<CareerTimeline />
</ModuleWrapper>
