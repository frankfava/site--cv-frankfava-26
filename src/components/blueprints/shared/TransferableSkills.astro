---
import ModuleWrapper, { type _ModuleWrapper, type _ModuleHeader } from "@/components/ui/modules/ModuleWrapper.astro";
import { Icon } from "astro-icon/components";
import { getTransferableSkills } from "@/lib/collections/transferableSkills";

export interface Props extends _ModuleWrapper {}

const props = Astro.props;

const skills = (await getTransferableSkills()).filter(({ data }) => data.listed);

const header: _ModuleHeader = {
	...props.header,
	title: props.header?.title || "Transferable Skills",
};
---

<ModuleWrapper {...{ ...props, header }}>
	<p class="text-lg">Each one below is something I still use in the work, not a line borrowed from an old job description.</p>

	<ul class="mt-8 grid gap-4 md:grid-cols-2">
		{
			skills.map(({ data }) => (
				<li class="flex items-start gap-3 rounded-md border border-line bg-surface p-4">
					{data.icon && <Icon name={data.icon} class="size-7 shrink-0 text-accent" />}
					<div class="grow">
						<div class="leading-tight font-semibold">{data.title}</div>
						{data.summary && <p class="m-0 mt-1 text-sm text-ink-3">{data.summary}</p>}
					</div>
				</li>
			))
		}
	</ul>

	<div class="mt-8 rounded border border-line bg-sunk p-5">
		<h3 class="mt-0 mb-3 text-lg">What leading them actually looks like</h3>
		<p>
			I think of it like managing a football side. The manager never touches the ball on match day. You pick the players, drill the patterns in training, set the shape, then trust them to read
			the game and make their own calls in the moment. You can't run onto the pitch and take the shot yourself, and you wouldn't want to.
		</p>
		<p>
			That's the part of working for myself I didn't expect to like. When a job was bigger than me I brought developers in, and what decided how it went was never the code — it was whether I'd
			been clear enough about the shape before anyone started. It's the same with the contractors now.
		</p>
		<p class="mb-0">I'm still hands-on, and I wouldn't take a role that took the keyboard away. But the work I point at is the work that kept running after I stopped touching it.</p>
	</div>
</ModuleWrapper>
