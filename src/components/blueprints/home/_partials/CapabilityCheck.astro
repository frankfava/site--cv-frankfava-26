---
/** The capability check: the sliders, and the radar they redraw. */
import { twMerge } from "tailwind-merge";
import { CAPABILITIES } from "@/data/capabilities";
import { radar } from "@/alpine/capability/radar";

export interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class={twMerge("text-left", className)} x-data="capabilityPanel">
	<div class="grid grid-cols-1 items-start gap-3.5 xl:grid-cols-[minmax(0,1fr)_minmax(0,352px)]">
		<div class="overflow-hidden rounded-lg border border-line bg-surface shadow-(--c-shadow)">
			<div class="flex items-center gap-3 border-b border-line-2 bg-sunk px-4.5 py-3">
				<span class="eyebrow text-ink-3">What your role needs</span>
				<button
					type="button"
					class="ml-auto cursor-pointer rounded border border-line px-2.5 py-1.5 font-mono text-xs tracking-wider text-ink-2 uppercase hover:border-accent hover:text-accent"
					x-on:click="reset">Reset</button
				>
			</div>

			<div class="px-4.5 pt-1 pb-4">
				{
					CAPABILITIES.map((cap) => (
						<div class="border-b border-line-2 py-3.5 last:border-b-0" x-data="capabilityRow" data-capability={cap.id}>
							<div class="mb-0.5 flex items-baseline gap-3">
								<label class="text-base font-semibold" for={`need-${cap.id}`}>
									{cap.label}
								</label>
								<span class="ml-auto font-mono text-xs whitespace-nowrap text-ink-3">
									need{" "}
									<b class="font-medium text-ink tab" x-text="need">
										{cap.defaultNeed}
									</b>
								</span>
							</div>

							<p class="mb-2.5 text-sm text-ink-3">{cap.evidence}</p>

							<input
								class="m-0 block w-full accent-accent"
								type="range"
								id={`need-${cap.id}`}
								min="0"
								max="100"
								step="5"
								value={cap.defaultNeed}
								x-bind:value="need"
								x-on:input="setNeed"
							/>

							<div class="mt-2 flex items-center gap-2 text-sm text-ink-3 [&.is-covered]:text-good [&.is-gap]:text-bad [&.is-tight]:text-warn" x-bind:class="verdictClass">
								<i class="size-2 flex-none rounded-full bg-current" />
								<span x-text="verdictText">Covered, with room to spare.</span>
							</div>
						</div>
					))
				}
			</div>
		</div>

		<div class="overflow-hidden rounded-lg border border-line bg-surface shadow-(--c-shadow)">
			<div class="flex items-center gap-3 border-b border-line-2 bg-sunk px-4.5 py-3">
				<span class="eyebrow text-ink-3">Your role vs me</span>
			</div>

			<div class="px-2 pt-3.5 pb-0.5">
				<svg class="block h-auto w-full" viewBox={radar.viewBox} role="img" aria-label="Radar comparing what your role needs against Frank's evidence">
					{radar.rings.map((d) => <path d={d} fill="none" stroke="var(--c-line)" stroke-width="1" />)}
					{
						radar.spokes.map((spoke) => (
							<>
								<line x1={radar.cx} y1={radar.cy} x2={spoke.x2} y2={spoke.y2} stroke="var(--c-line)" stroke-width="1" />
								<text x={spoke.labelX} y={spoke.labelY} text-anchor={spoke.anchor} fill="var(--c-ink-3)" font-size="10.5" letter-spacing=".4">
									{spoke.label}
								</text>
							</>
						))
					}
					<path d={radar.mineShape} stroke="var(--c-good)" fill="color-mix(in srgb, var(--c-good) 16%, transparent)" stroke-width="2" stroke-linejoin="round"></path>
					<path
						d={radar.yoursShape}
						x-bind:d="yoursShape"
						stroke="var(--c-accent)"
						fill="color-mix(in srgb, var(--c-accent) 12%, transparent)"
						stroke-width="2"
						stroke-linejoin="round"
						stroke-dasharray="5 4"></path>
				</svg>
			</div>

			<div class="flex flex-wrap gap-4 px-4 pt-0.5 pb-3.5 font-mono text-xs font-medium tracking-wider text-ink-3 uppercase">
				<span class="flex items-center gap-1.5"><i class="h-1 w-4 rounded-xs bg-accent"></i>What you need</span>
				<span class="flex items-center gap-1.5"><i class="h-1 w-4 rounded-xs bg-good"></i>Where I sit</span>
			</div>
		</div>
	</div>
</div>
