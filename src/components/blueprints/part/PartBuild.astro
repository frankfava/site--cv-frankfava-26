---
import { isVisible, loadPart, partComponent, type AssembledPart } from "@/lib/blueprints";
import type { HTMLAttributes } from "astro/types";

export interface Props {
	section: AssembledPart;
	class?: HTMLAttributes<any>["class:list"];
}

const { section: s, class: className } = Astro.props;
const { props, content, ...section } = s;

const mod = await loadPart(content);
const Part = partComponent(content, mod);
const isHidden = section.hidden || !(await isVisible(mod));
---

{
	!isHidden &&
		(Part ? (
			<Part
				{...{
					...section,
					...props,
					id: section.id,
					eyebrow: section.eyebrow,
					title: section.title,
					subtitle: section.description,
					icon: section.icon,
					class: className,
				}}
			/>
		) : (
			typeof content === "string" && <Fragment set:html={content} />
		))
}
