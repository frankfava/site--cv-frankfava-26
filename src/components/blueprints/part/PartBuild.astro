---
import { isVisible, loadPart, type AssembledPart } from "@/lib/blueprints";
import type { HTMLAttributes } from "astro/types";

export interface Props {
	section: AssembledPart;
	class?: HTMLAttributes<"section">["class:list"];
}

const { section, class: className } = Astro.props;

const part = await loadPart(section.content);
const isHidden = section.hidden || !(await isVisible(part));
---

{
	!isHidden && (
		<section class:list={className}>
			<h2 class="mb-[1.8mm] font-mono text-[0.68rem]/[1.05] font-medium tracking-[0.11em] text-ink-3 uppercase">{section.title}</h2>
			{part ? <part.default /> : typeof section.content === "string" && <Fragment set:html={section.content} />}
		</section>
	)
}
