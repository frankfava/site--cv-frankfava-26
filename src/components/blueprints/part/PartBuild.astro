---
import { isVisible, loadPart, partComponent, type AssembledPart } from "@/lib/blueprints";
import type { HTMLAttributes } from "astro/types";

export interface Props {
	section: AssembledPart;
	class?: HTMLAttributes<"section">["class:list"];
}

const { section, class: className } = Astro.props;

const mod = await loadPart(section.content);
const Part = partComponent(section.content, mod);
const isHidden = section.hidden || !(await isVisible(mod));
---

{
	!isHidden && (
		<section class:list={className}>
			<h2 class="mb-4 text-lg/[1.05]">{section.title}</h2>
			{Part ? <Part {...section.props} /> : typeof section.content === "string" && <Fragment set:html={section.content} />}
		</section>
	)
}
