---
import type { HTMLAttributes } from "astro/types";
import PartBuild, { type Props as PartBuildProps } from "./PartBuild.astro";
import { type AssembledParts } from "@/lib/blueprints";
import { cn } from "@/utils/class";

export interface Props {
	sheet: AssembledParts;
	class?: HTMLAttributes<any>["class:list"];
	sectionClass?: PartBuildProps["class"];
}

const { sheet, class: className, sectionClass } = Astro.props;
---

{
	!!sheet.length && (
		<div class={cn("mb-4", className)}>
			{sheet.map((section) => (
				<PartBuild {...{ section, class: sectionClass }} />
			))}
		</div>
	)
}
