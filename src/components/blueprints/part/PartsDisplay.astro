---
import PartBuild, { type Props as PartBuildProps } from "./PartBuild.astro";
import { type AssembledParts } from "@/lib/blueprints";

export interface Props {
	sheet: AssembledParts;
	sectionClass?: PartBuildProps["class"];
}

const { sheet, sectionClass } = Astro.props;
---

{
	!!sheet.length && (
		<div class="mb-6 space-y-5">
			{sheet.map((section) => (
				<PartBuild {...{ section, class: sectionClass }} />
			))}
		</div>
	)
}
