---
import { SOCIALS } from "site:config";

import Logo from "@/components/Logo.astro";
import SocialLinks from "@/components/ui/menu/SocialLinks.astro";
import ToggleTheme from "@/components/ui/menu/ToggleTheme.astro";
import ToggleMenu from "@/components/ui/menu/ToggleMenu.astro";
import ButtonGroup from "@/components/ui/input/ButtonGroup.astro";
import MenuItems from "@/components/ui/menu/MenuItems.astro";
import NavSidebar from "@/components/ui/menu/NavSidebar.astro";
import { Icon } from "astro-icon/components";

import type { Link, _CallToAction } from "@/types";
import { getCurrentPath, getHomePermalink } from "@/utils/permalinks";
import type { BlueprintBuilder, BlueprintSchema } from "@/lib/blueprints";

export interface Props {
	id?: string;
	links?: Array<Link>;
	actions?: Array<_CallToAction>;
	logo?: string;
	sidebarToggle?: string;
	beforeMenu?: string;
	afterMenu?: string;
	beforeActions?: string;
	afterActions?: string;
	isSticky?: boolean;
	isDark?: boolean;
	addShadow?: boolean;
	isFullWidth?: boolean;
	showSocialLinks?: boolean;
	showToggleTheme?: boolean;
	showLinkIcons?: boolean;
	showScrollProgress?: boolean;
	animateScrollProgress?: boolean;
	showBookmarks?: boolean;
	shrinkHeader?: boolean;
	position?: "left" | "right" | "center";
	blueprint?: BlueprintBuilder<BlueprintSchema>;
}

const {
	id = "header",
	links = [],
	actions = [],
	logo = await Astro.slots.render("logo"),
	sidebarToggle = await Astro.slots.render("sidebarToggle"),
	beforeMenu = await Astro.slots.render("beforeMenu"),
	afterMenu = await Astro.slots.render("afterMenu"),
	beforeActions = await Astro.slots.render("beforeActions"),
	afterActions = await Astro.slots.render("afterActions"),
	isSticky = true,
	isDark = true,
	addShadow = true,
	isFullWidth = true,
	showToggleTheme = false,
	showSocialLinks = true,
	showScrollProgress = true,
	animateScrollProgress = true,
	showBookmarks = false,
	shrinkHeader = false,
	showLinkIcons,
	position = "center",
	blueprint,
} = Astro.props;

// Sidebar visibility comes from the active entry's layout config - Defaults to true
const showSidebar = Astro.locals.blueprint?.config?.layout?.showSidebar ?? true;

// A shell can drive the sidebar without giving the header a menu: the indexed
//  layout keeps its links in the bay, so `links` is empty here while both
//  toggles are still wanted. Supplying the slot is the explicit signal.
const hasSidebar = !!links.length || (blueprint && showSidebar) || Astro.slots.has("sidebarToggle");

const currentPath = getCurrentPath(Astro.url);
---

<>
	<header
		class:list={[
			{
				fixed: isSticky,
				relative: !isSticky,
				dark: isDark,
				"shadow-[0_5px_10px_0_rgba(0,0,0,0.3)]": addShadow,
			},
			"top-0 !z-[50] w-full font-primary bg-header text-page flex flex-col print:hidden",
		]}
		{...isSticky ? { "data-sticky-header": true } : {}}
		{...shrinkHeader ? { "data-shrink-header": true } : {}}
		{...showScrollProgress
			? {
					'data-scroll-progress="animate"': animateScrollProgress,
					'data-scroll-progress="show"': !animateScrollProgress,
				}
			: {}}
		{...id ? { id } : {}}
	>
		<div
			id="header-inner"
			class:list={[
				"relative h-20 text-default px-3 md:px-6 mx-auto w-full gap-5 lg:grow",
				{
					"md:flex md:justify-between items-center": position !== "center",
					"flex w-full items-center": position === "center",
					"max-w-screen-2xl": !isFullWidth,
				},
			]}
		>
			<div class:list={[{ "mr-auto rtl:mr-0 rtl:ml-auto": position === "right" }, "flex items-center gap-2 md:gap-5"]}>
				{hasSidebar && <ToggleMenu class="mobile-toggle" />}
				<a class="flex items-center logo-link" href={currentPath == "/" ? "#top" : getHomePermalink()}>
					{Astro.slots.has("logo") && typeof logo == "string" && !!logo ? <Fragment set:html={logo} /> : <Logo showImage={true} class="site-logo" />}
				</a>
				{
					hasSidebar &&
						(Astro.slots.has("sidebarToggle") && typeof sidebarToggle == "string" && !!sidebarToggle ? (
							<Fragment set:html={sidebarToggle} />
						) : (
							<ToggleMenu class="sidebar-toggle">
								<Icon name="ph:sidebar-duotone" class="w-8 h-8" />
							</ToggleMenu>
						))
				}
			</div>
			{Astro.slots.has("beforeMenu") && typeof beforeMenu == "string" && !!beforeMenu ? <Fragment set:html={beforeMenu} /> : ""}
			<div
				class="flex"
				class:list={{
					"mx-auto": position === "center",
					"mr-auto": position === "left",
					"ml-auto": position === "right",
				}}
			>
				{
					!!links.length && (
						<nav id="header-nav" class="flex justify-self-center items-center w-auto text-default md:overflow-x-auto xl:overflow-x-hidden" aria-label="Main navigation">
							<ul class="flex flex-row justify-center gap-2 py-0 w-full font-semibold text-[0.8rem] self-center">
								<MenuItems links={links} showLinkIcons={showLinkIcons} />
							</ul>
						</nav>
					)
				}
			</div>
			{Astro.slots.has("afterMenu") && typeof afterMenu == "string" && !!afterMenu ? <Fragment set:html={afterMenu} /> : ""}
			<div
				class:list={[
					{ "ml-auto rtl:ml-0 rtl:mr-auto": position === "left" },
					" hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 md:justify-self-end",
				]}
			>
				<div class="flex justify-between sm:justify-normal items-center gap-3 lg:gap-2 w-full sm:w-auto ml-0">
					{Astro.slots.has("beforeActions") && typeof beforeActions == "string" && !!beforeActions ? <Fragment set:html={beforeActions} /> : ""}
					<ButtonGroup actions={actions.slice(0, 2)} btnClass="py-2.5 px-5.5 md:px-6" />
					{showSocialLinks && <SocialLinks slot="actions" socialLinks={SOCIALS.toArray()} showText={false} class="gap-1 lg:gap-2" linkClass="rounded-md p-2" iconClass="w-6 h-6" />}
					{showToggleTheme && <ToggleTheme class="p-2 rounded-md" iconClass="w-6 h-6" />}
					{Astro.slots.has("afterActions") && typeof afterActions == "string" && !!afterActions ? <Fragment set:html={afterActions} /> : ""}
				</div>
			</div>
		</div>
	</header>
	<!-- {hasSidebar && <NavSidebar links={links} blueprint={blueprint} />} -->
</>
