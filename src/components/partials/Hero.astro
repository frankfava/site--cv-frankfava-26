---
import { ABOUT, DISPLAY } from "site:config";

export interface Props {
	title?: string;
	description?: string;
	eyebrow?: string;
	facts?: Array<{ value: string; label: string }>;
}

const { title, description, eyebrow, facts = [] } = Astro.props;

const eyebrowSlot = await Astro.slots.render("eyebrow");
---

<header
	class="relative bg-[#08080e] border-line border-b overflow-hidden text-[#f2f2f8] before:absolute before:inset-0 before:content-[''] before:pointer-events-none before:bg-[radial-gradient(760px_420px_at_16%_8%,rgba(34,211,238,0.2),transparent_62%),radial-gradient(720px_460px_at_84%_92%,rgba(139,92,246,0.24),transparent_60%)]"
	x-data="particleField"
>
	<canvas class="absolute inset-0 opacity-85 w-full h-full" x-ref="canvas" aria-hidden="true"></canvas>

	<div class="relative mx-auto px-5.5 md:px-8.5 pt-12.5 md:pt-18 pb-11 md:pb-15 max-w-(--content-width)">
		{(!!eyebrowSlot?.trim() || eyebrow) && <span class="block mb-5 text-cyan eyebrow">{!!eyebrowSlot?.trim() ? <Fragment set:html={eyebrowSlot} /> : eyebrow}</span>}

		<h1
			class="heading-display max-w-[20ch] font-bold text-[clamp(2.1rem,4.6vw,3.5rem)] text-white! [&_b]:bg-clip-text [&_b]:bg-[linear-gradient(96deg,#67e8f9,#c4b5fd_60%,#f0abfc)] [&_b]:text-transparent"
		>
			<slot name="heading">{title}</slot>
		</h1>

		{
			(description || Astro.slots.has("lead")) && (
				<p class="mt-5 max-w-[58ch] text-[1.08rem] text-[#a8a8bd] [&_b]:font-semibold [&_b]:text-white">
					<slot name="lead">{description}</slot>
				</p>
			)
		}

		{
			!!facts.length && (
				<div class="flex flex-wrap gap-2 mt-7">
					{facts.map((f) => (
						<span class="bg-white/4 px-3.5 py-1.5 border border-[#26263a] rounded-full text-[0.88rem] text-[#a8a8bd]">
							<b class="font-semibold text-white">{f.value}</b> {f.label}
						</span>
					))}
				</div>
			)
		}
	</div>
</header>
