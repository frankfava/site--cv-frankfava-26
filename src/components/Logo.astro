---
import { Image } from "astro:assets";
import { ABOUT, DISPLAY } from "site:config";

export interface Props {
	class?: string;
	showImage?: boolean;
}

const { class: className = "", showImage = DISPLAY.showAvatar ?? false } = Astro.props;
---

<div class="flex min-h-12 items-center gap-3 self-center whitespace-nowrap" class:list={[className]}>
	{showImage && !!ABOUT.getImage("bw") && <Image src={ABOUT.getImage("bw") as string} width={90} height={90} alt={`${ABOUT.name} Face`} class="max-h-12 w-auto rounded-full" />}
	<span class="font-primary text-lg font-extrabold! whitespace-nowrap text-ink! uppercase [font-variation-settings:'wdth'_88] hover:text-accent!"
		>{ABOUT.firstName}
		<span class="ml-1">{ABOUT.lastName}</span></span
	>
</div>
