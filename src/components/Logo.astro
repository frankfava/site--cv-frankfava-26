---
import { cn } from "@/utils/class";
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import { ABOUT, DISPLAY } from "site:config";

export interface Props {
	class?: string;
	titleClass?: HTMLAttributes<"div">["class:list"];
	showImage?: boolean;
}

const { class: className = "", titleClass, showImage = DISPLAY.showAvatar ?? false } = Astro.props;
---

<div class="site-logo flex items-center gap-3 self-center whitespace-nowrap" class:list={[className]}>
	{showImage && !!ABOUT.getImage("bw") && <Image src={ABOUT.getImage("bw") as string} width={180} height={180} alt={`${ABOUT.name} Face`} class="w-auto rounded-full" />}
	<div>
		<div class={cn("font-primary text-lg font-extrabold! tracking-[-0.02em] whitespace-nowrap text-ink! uppercase [font-variation-settings:'wdth'_88] hover:text-accent!", titleClass)}>
			{ABOUT.firstName}
			<span class="ml-1 font-normal!">{ABOUT.lastName}</span>
		</div>
		<slot />
	</div>
</div>
