---
/**
 * An adaptive layout for indexed pages.
 */
import { ABOUT, DISPLAY } from "site:config";
import PageLayout, { type Props as LayoutProps } from "@/layouts/PageLayout.astro";
import { type BlueprintEntry } from "@/lib/blueprints";

import BlueprintDisplay from "@/components/blueprints/BlueprintDisplay.astro";
import ToggleBay from "@/components/ui/sidebar/ToggleBay.astro";
import IndexBay, { type Props as IndexBayProps } from "@/components/shared/sidebar/IndexBay.astro";
import IndexRail from "@/components/shared/menu/IndexRail.astro";
import Tagline from "@/components/shared/Tagline.astro";
import Availability from "@/components/shared/Availability.astro";
import PersonJsonLd from "@/components/shared/PersonJsonLd.astro";
import { destinations } from "@/lib/fullRecord";
import type { Link } from "@/types";
import Search from "@/components/ui/search/Search.astro";
import SearchButton from "@/components/ui/search/SearchButton.astro";
import { searchIndexes } from "@/data/search";
import { searchIndexFor } from "@/lib/search";

export interface Props extends LayoutProps {
	blueprint?: BlueprintEntry;
	contentLinks?: IndexBayProps["links"];
	sidebar?: Omit<IndexBayProps, "navLinks" | "links">;
	showRail?: boolean;
	fullHeight?: boolean;
}

const { blueprint: entry, contentLinks, showRail, header, footer, showSidebar, showFooter: showFooterProp, fullHeight, sidebar, ...rest } = Astro.props;

Astro.locals.blueprint = entry;

let useSidebar = true;
if (showSidebar != undefined) {
	useSidebar = showSidebar;
} else if (entry && entry?.config?.layout?.showSidebar != undefined) {
	useSidebar = entry.config.layout.showSidebar;
}

let useRail = useSidebar;
if (showRail != undefined) {
	useRail = showRail;
}

let useFullHeight = false;
if (fullHeight != undefined) {
	useFullHeight = fullHeight;
} else if (entry && entry?.config?.layout?.fullHeight != undefined) {
	useFullHeight = entry.config.layout.fullHeight;
}

const showFooter = entry?.config?.layout?.showFooter ?? showFooterProp;

// A page carries search only where its blueprint names an index, which is what
// keeps it off the pages that name none.
const searchIndex = searchIndexFor(searchIndexes, entry);

const layoutProps: LayoutProps = {
	...rest,
	bodyClass: "indexed",
	showSidebar: useSidebar,
	fullHeight: useFullHeight,
	showFooter,
	header: { isDark: undefined, ...header },
	footer: { showSocialText: true, ...footer },
};

const fullRecord: Link[] = (await destinations()).map((destination) => ({
	text: destination.title,
	icon: destination.titleIcon,
	href: destination.link?.href ?? "",
}));

const _header = await Astro.slots.render("header");
const _footer = await Astro.slots.render("footer");
const _sidebarToggle = await Astro.slots.render("_sidebarToggle");
const _sidebar = await Astro.slots.render("sidebar");
const _content = await Astro.slots.render("default");
const _rail = await Astro.slots.render("rail");
---

<PageLayout {...layoutProps}>
	<Fragment slot={!!_header?.trim() ? "header" : ""} set:html={_header} />

	<Fragment slot="sidebarToggle">{_sidebarToggle?.trim() ? <Fragment set:html={_sidebarToggle} /> : <ToggleBay />}</Fragment>

	<Fragment slot="beforeMenu">
		{DISPLAY.showTagline && DISPLAY.tagline && <Tagline class="hidden xl:block" tagline={DISPLAY.tagline} />}
		<slot name="beforeMenu" />
	</Fragment>
	<slot name="afterMenu" slot="afterMenu" />

	<Fragment slot="beforeActions">
		{DISPLAY.showAvailability && <Availability {...ABOUT.availability} class="mr-3" />}
		{searchIndex && <SearchButton />}
		<slot name="beforeActions" />
	</Fragment>
	<slot name="afterActions" slot="afterActions" />

	<slot slot="hero" name="hero" />

	{
		_sidebar?.trim() ? (
			<Fragment slot="sidebar" set:html={_sidebar} />
		) : (
			useSidebar && (
				<IndexBay
					slot="sidebar"
					{...{
						navLinks: layoutProps.header?.links ?? fullRecord,
						links: contentLinks,
						...sidebar,
					}}
				/>
			)
		)
	}

	<Fragment slot={!!_footer?.trim() ? "footer" : ""} set:html={_footer} />

	<Fragment>
		{_content?.trim() ? <Fragment set:html={_content} /> : entry && <BlueprintDisplay blueprint={entry.blueprint ? entry.blueprint.assemble() : []} />}
	</Fragment>

	<Fragment slot="afterFooter">
		<div class="scrim" aria-hidden="true" data-sidebar-scrim></div>
		{useRail && (_rail?.trim() ? <Fragment set:html={_rail} /> : <IndexRail links={contentLinks} />)}
		<slot name="afterFooter" />
		{searchIndex && <Search index={searchIndex} />}
		<PersonJsonLd />
	</Fragment>
</PageLayout>
