---
/**
 * Define Layout that can be used to display a blueprint and pass
 * information to the header as needed
 */

import PageLayout, { type Props as LayoutProps } from "@/layouts/PageLayout.astro";
import { type BlueprintEntry } from "@/lib/blueprints";

import BlueprintDisplay from "@/components/ui/blueprint/BlueprintDisplay.astro";

export interface Props extends LayoutProps {
	blueprint: BlueprintEntry;
}

const { blueprint: entry, header, ...rest } = Astro.props;

Astro.locals.blueprint = entry;

// const search = resolveSearchFeatures(entry.slug);

const showFooter = entry.config?.layout?.showFooter ?? true;
---

<PageLayout
	{...{
		...rest,
		header: {
			...header,
			blueprint: entry.blueprint,
		},
	}}
>
	<slot name="beforeMenu" slot="beforeMenu" />
	<slot name="afterMenu" slot="afterMenu" />

	<Fragment slot="beforeActions">
		<slot name="beforeActions" />
	</Fragment>
	<slot name="afterActions" slot="afterActions" />

	<BlueprintDisplay blueprint={entry.blueprint ? entry.blueprint.assemble() : []} />

	<Fragment slot={!showFooter ? "footer" : ""}></Fragment>

	<Fragment slot="afterFooter">
		<slot name="afterFooter" />
	</Fragment>
</PageLayout>
