---
import Layout, { type Props as BaseLayoutProps } from "@/layouts/BaseLayout.astro";
import MainHeader, { type Props as HeaderProps } from "@/components/includes/MainHeader.astro";
import MainFooter, { type Props as FooterProps } from "@/components/includes/MainFooter.astro";
import ScrollTop from "@/components/ui/scroll/ScrollTop.astro";

export interface Props extends BaseLayoutProps {
	header?: HeaderProps;
	footer?: FooterProps;
	showSidebar?: boolean;
	/** Move the hero inside the content column, beside a sidebar that is full height from the first paint. */
	fullHeight?: boolean;
	footerInContent?: boolean;
	showScrollTop?: boolean;
}

const { header, footer, showSidebar, fullHeight = false, footerInContent = true, showScrollTop = true, ...baseLayoutProps } = Astro.props;

const sidebar = await Astro.slots.render("sidebar");
const useSidebar = showSidebar && Astro.slots.has("sidebar") && !!sidebar?.trim();
---

<Layout {...baseLayoutProps}>
	<slot name="header">
		<MainHeader {...{ ...header, showSidebar: useSidebar }}>
			<slot name="logo" slot="logo" />
			<slot name="sidebarToggle" slot="sidebarToggle" />
			<slot name="beforeMenu" slot="beforeMenu" />
			<slot name="afterMenu" slot="afterMenu" />
			<slot name="beforeActions" slot="beforeActions" />
			<slot name="afterActions" slot="afterActions" />
		</MainHeader>
	</slot>

	<div id="wrapper">
		<main class="bg-ground font-secondary text-[17.34px]/[1.62] text-ink">
			{!fullHeight && <slot name="hero" />}

			<div
				class:list={[
					"grid grid-cols-1 items-start transition-[grid-template-columns] duration-300 ease-[cubic-bezier(0.3,0.8,0.3,1)]",
					{ "lg:grid-cols-[var(--sidebar-width)_minmax(0,1fr)]": useSidebar },
				]}
				data-full-height={fullHeight ? "" : undefined}
			>
				{useSidebar && <Fragment set:html={sidebar} />}

				<div class:list={["mx-auto w-full", { "lg:col-start-2": useSidebar }]}>
					{fullHeight && <slot name="hero" />}
					<slot />
					{
						footerInContent && (
							<slot name="footer">
								<MainFooter {...footer} />
							</slot>
						)
					}
				</div>
			</div>
		</main>

		{
			!footerInContent && (
				<div class:list={["px-5 pb-15 transition-[margin-left] duration-300 ease-[cubic-bezier(0.3,0.8,0.3,1)] sm:px-10.5 sm:pb-17.5"]}>
					<slot name="footer">
						<MainFooter {...footer} />
					</slot>
				</div>
			)
		}
	</div>

	{showScrollTop && <ScrollTop />}
	<slot name="afterFooter" />
</Layout>
