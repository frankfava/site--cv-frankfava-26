---
import Layout, { type Props as BaseLayoutProps } from "@/layouts/BaseLayout.astro";
import MainHeader, { type Props as HeaderProps } from "@/components/includes/MainHeader.astro";
import MainFooter, { type Props as FooterProps } from "@/components/includes/MainFooter.astro";
import ScrollTop from "@/components/ui/menu/ScrollTop.astro";

export interface Props extends BaseLayoutProps {
	header?: HeaderProps;
	footer?: FooterProps;
	showScrollTop?: boolean;
}

const { header, footer, showScrollTop = true, ...baseLayoutProps } = Astro.props;
---

<Layout {...baseLayoutProps}>
	<slot name="header">
		<MainHeader {...header}>
			<slot name="logo" slot="logo" />
			<slot name="sidebarToggle" slot="sidebarToggle" />
			<slot name="beforeMenu" slot="beforeMenu" />
			<slot name="afterMenu" slot="afterMenu" />
			<slot name="beforeActions" slot="beforeActions" />
			<slot name="afterActions" slot="afterActions" />
		</MainHeader>
	</slot>
	<div id="wrapper">
		<main class="flex flex-col">
			<slot />
		</main>
		<slot name="footer">
			<MainFooter {...footer} />
		</slot>
	</div>
	{showScrollTop && <ScrollTop />}
	<slot name="afterFooter" />
</Layout>
