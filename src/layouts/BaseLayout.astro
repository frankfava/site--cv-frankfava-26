---
import "@/assets/css/main.css";

import { I18N } from "site:config";
import { cn } from "@/utils/class";

import Favicons from "@/components/includes/Favicons.astro";
import CustomStyles from "@/components/includes/CustomStyles.astro";
import MetaTags from "@/components/includes/MetaTags.astro";
import JsApplyColorMode from "@/components/includes/JsApplyColorMode.astro";
import JsApplySidebarState from "@/components/includes/JsApplySidebarState.astro";
import Analytics from "@/components/includes/Analytics.astro";
import Fonts from "@/components/includes/Fonts.astro";

import type { MetaData } from "@/types";
import type { HTMLAttributes } from "astro/types";

export interface Props {
	metadata?: MetaData;
	htmlClass?: HTMLAttributes<"html">["class:list"];
	bodyClass?: HTMLAttributes<"body">["class:list"];
}

const { metadata = {}, htmlClass = "", bodyClass = "" } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class:list={htmlClass}>
	<head>
		<Favicons />
		<MetaTags {...metadata} />
		<Analytics />
		<Fonts />
		<CustomStyles />
		<JsApplyColorMode />
		<JsApplySidebarState />
	</head>
	<body id="top" class={cn(["bg-page text-base tracking-tight text-page antialiased", bodyClass])}>
		<slot />

		<script src="../assets/js/main.js"></script>
	</body>
</html>
