{
	"extends": "astro/tsconfigs/base",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"site:config": [
				"src/siteConfig.ts"
			],
			"@/*": [
				"src/*"
			]
		},
		"allowJs": true,
		"strictNullChecks": true,
		"noUnusedLocals": false,
		"jsx": "preserve"
	},
	"include": [
		".astro/types.d.ts",
		"**/*"
	],
	"exclude": [
		"dist"
	]
}